                        <span>Kiểm tra kết nối</span>
                      </button>
                      <button onClick={async () => { const res = await callBackend('setupDatabase'); showToast(res.message || 'Đã khởi tạo Database!'); }} className="px-3 py-2.5 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold flex items-center justify-center gap-1.5">
                        <Table2 className="w-4 h-4" />
                        <span>Initialize Database</span>
                      </button>
                      <button onClick={async () => { await callBackend('seedDemoData'); showToast('Đã nạp dữ liệu mẫu doanh nghiệp!'); }} className="px-3 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-700 text-white text-xs font-bold flex items-center justify-center gap-1.5">
                        <Sparkles className="w-4 h-4" />
                        <span>Seed Demo Data</span>
                      </button>
                      <button onClick={() => setConfirmDialog({ open: true, title: 'Xóa dữ liệu mẫu', message: 'Bạn có chắc muốn xóa toàn bộ dữ liệu mẫu hiện tại?', onConfirm: async () => { setConfirmDialog({ open: false, title: '', message: '', onConfirm: null }); await callBackend('clearDemoData'); showToast('Đã xóa dữ liệu mẫu!'); } })} className="px-3 py-2.5 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold flex items-center justify-center gap-1.5">
                        <Trash2 className="w-4 h-4" />
                        <span>Clear Demo Data</span>
                      </button>
                    </div>
                  </div>

                  <div className="lg:col-span-6 glass-card p-5 rounded-2xl space-y-4">
                    <h2 className="font-bold text-base text-slate-900">Quy tắc Scoring Engine & Ngưỡng cảnh báo (SETTINGS)</h2>
                    <div className="grid grid-cols-2 gap-3 text-xs">
                      <div>
                        <label className="block font-bold text-slate-700 mb-1">Tên Doanh nghiệp</label>
