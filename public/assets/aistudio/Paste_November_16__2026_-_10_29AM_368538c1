                      <option value="Company">Company</option>
                      <option value="Division">Division</option>
                      <option value="Department">Department</option>
                      <option value="Team">Team</option>
                      <option value="Individual">Individual</option>
                    </select>
                    <select value={objStatusFilter} onChange={(e) => setObjStatusFilter(e.target.value)} className="text-xs font-bold text-slate-700 bg-white/85 border border-white rounded-xl px-3 py-1.5 outline-none">
                      <option value="ALL">Tất cả trạng thái</option>
                      <option value="ON_TRACK">ON TRACK</option>
                      <option value="AT_RISK">AT RISK</option>
                      <option value="BEHIND">BEHIND</option>
                      <option value="COMPLETED">COMPLETED</option>
                      <option value="NOT_STARTED">NOT STARTED</option>
                    </select>
                  </div>
                </div>

                {/* Objectives Content */}
                {filteredManagementObjectives.length === 0 ? (
                  <div className="glass-card p-10 rounded-2xl text-center space-y-3">
                    <p className="text-sm font-bold text-slate-700">{lang === 'ko' ? '조건에 일치하는 목표가 없습니다.' : 'Không có Mục tiêu nào khớp với điều kiện lọc.'}</p>
                    <button onClick={() => openAddOkrModal()} className="px-4 py-2 rounded-xl bg-indigo-600 text-white text-xs font-bold">+ {t.addObjectiveBtn}</button>
                  </div>
                ) : objViewMode === 'table' ? (
                  <div className="glass-card rounded-2xl overflow-x-auto">
                    <table className="w-full text-left border-collapse text-xs">
                      <thead>
                        <tr className="border-b border-white bg-white/60 text-slate-600">
                          <th className="p-3.5 font-bold">Objective</th>
                          <th className="p-3.5 font-bold">Level / Dept</th>
                          <th className="p-3.5 font-bold">Owner</th>
                          <th className="p-3.5 font-bold">Progress</th>
                          <th className="p-3.5 font-bold">Status</th>
                          <th className="p-3.5 font-bold text-right">Actions</th>
                        </tr>
                      </thead>
                      <tbody className="divide-y divide-white/70">
                        {filteredManagementObjectives.map(obj => {
                          const dept = db.departments.find(d => d.departmentId === obj.departmentId);
                          const owner = db.users.find(u => u.userId === obj.ownerId);
                          return (
                            <tr key={obj.objectiveId} className="hover:bg-white/70">
                              <td className="p-3.5 font-bold text-slate-900 max-w-xs">{renderLocalized(obj, 'title')}</td>
                              <td className="p-3.5">{obj.level} • {dept ? getRawLocalized(dept, 'name') : ''}</td>
                              <td className="p-3.5">{owner ? getRawLocalized(owner, 'displayName') : obj.ownerId}</td>
                              <td className="p-3.5 font-bold text-indigo-700">{obj.progress || 0}%</td>
                              <td className="p-3.5">{renderStatusPill(obj.status)}</td>
                              <td className="p-3.5 text-right space-x-1">
                                <button onClick={() => setDetailModalObjId(obj.objectiveId)} className="px-2 py-1 rounded bg-white text-slate-700 font-bold">Chi tiết</button>
                                <button onClick={() => openEditOkrModal(obj)} className="px-2 py-1 rounded bg-indigo-600 text-white font-bold">Sửa</button>
                              </td>
                            </tr>
                          );
                        })}
                      </tbody>
                    </table>
                  </div>
                ) : (
                  <div className={objViewMode === 'hierarchy' ? 'space-y-3' : 'grid grid-cols-1 xl:grid-cols-2 gap-5'}>
                    {filteredManagementObjectives.map(obj => {
                      const dept = db.departments.find(d => d.departmentId === obj.departmentId);
                      const owner = db.users.find(u => u.userId === obj.ownerId);
                      const krs = db.keyResults.filter(k => k.objectiveId === obj.objectiveId && !k.deletedAt);
                      return (
                        <div key={obj.objectiveId} className={`glass-card p-5 rounded-2xl flex flex-col justify-between gap-4 ${objViewMode === 'hierarchy' && obj.parentObjectiveId ? 'ml-6 border-l-4 border-l-indigo-600' : ''}`}>
                          <div>
                            <div className="flex items-center justify-between gap-2 mb-2.5">
                              <div className="flex flex-wrap items-center gap-1.5">
                                <span className="px-2.5 py-0.5 rounded-lg text-[11px] font-bold bg-indigo-600 text-white">{obj.level || 'Department'}</span>
                                <span className="px-2.5 py-0.5 rounded-lg text-[11px] font-bold bg-white text-slate-700 border border-white">{dept ? getRawLocalized(dept, 'name') : ''}</span>
                                {renderStatusPill(obj.status)}
                              </div>
                              <div className="flex items-center gap-1">
                                {obj.deletedAt ? (
                                  <button onClick={() => handleDeleteOrRestoreObjective(obj, true)} className="px-2.5 py-1 rounded-lg bg-emerald-600 text-white text-xs font-bold">Khôi phục</button>
                                ) : (
                                  <>
                                    <button onClick={() => setDetailModalObjId(obj.objectiveId)} title="Chi tiết" className="p-1.5 rounded-lg bg-white hover:bg-indigo-600 text-slate-700 hover:text-white transition-colors"><Eye className="w-3.5 h-3.5" /></button>
                                    <button onClick={() => handleCloneObjective(obj)} title="Nhân bản" className="p-1.5 rounded-lg bg-white hover:bg-indigo-600 text-slate-700 hover:text-white transition-colors"><Copy className="w-3.5 h-3.5" /></button>
                                    <button onClick={() => openEditOkrModal(obj)} title="Chỉnh sửa" className="p-1.5 rounded-lg bg-white hover:bg-indigo-600 text-slate-700 hover:text-white transition-colors"><Edit3 className="w-3.5 h-3.5" /></button>
                                    <button onClick={() => handleDeleteOrRestoreObjective(obj, false)} title="Xóa mềm" className="p-1.5 rounded-lg bg-white hover:bg-rose-600 text-slate-700 hover:text-white transition-colors"><Trash2 className="w-3.5 h-3.5" /></button>
                                  </>
                                )}
                              </div>
                            </div>

                            <div className="flex items-start justify-between gap-3 mb-2">
                              <div>
                                <h3 className="text-base font-bold text-slate-900 leading-snug">{renderLocalized(obj, 'title')}</h3>
                                <p className="text-xs text-slate-500 mt-1">{owner ? getRawLocalized(owner, 'displayName') : ''} • Weight: {obj.weight || 100}% • Due: {formatLocaleDate(obj.dueDate)}</p>
                              </div>
                              <span className="text-xl font-bold text-indigo-700 shrink-0">{obj.progress || 0}%</span>
                            </div>

                            <div className="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden mb-3.5">
                              <div className="bg-gradient-to-r from-blue-600 via-indigo-600 to-fuchsia-500 h-full rounded-full transition-all duration-500" style={{ width: `${obj.progress || 0}%` }} />
                            </div>

                            <div className="space-y-2 bg-white/70 p-3 rounded-xl border border-white">
                              <div className="flex items-center justify-between">
                                <span className="text-[11px] font-bold uppercase text-slate-500">Key Results ({krs.length})</span>
                                <button onClick={() => openKrModal(obj.objectiveId)} className="text-[11px] font-bold text-indigo-600 hover:underline">+ Thêm KR</button>
                              </div>
                              {krs.length === 0 ? (
                                <p className="text-xs text-slate-500 italic">Chưa có Key Result nào gắn với mục tiêu này.</p>
                              ) : krs.map((kr, idx) => (
                                <div key={kr.krId} className="p-2.5 rounded-xl bg-white border border-slate-100 flex items-center justify-between gap-2">
                                  <div className="min-w-0">
                                    <p className="text-xs font-bold text-slate-800 truncate"><span className="text-indigo-600">KR{idx + 1}:</span> {renderLocalized(kr, 'title')}</p>
                                    <p className="text-[11px] text-slate-500">{formatLocaleNumber(kr.currentValue, kr.metricType, kr.unit)} / {formatLocaleNumber(kr.targetValue, kr.metricType, kr.unit)} ({kr.progress || 0}%)</p>
                                  </div>
                                  <button onClick={() => openCheckInModal(kr)} className="px-2.5 py-1 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-[11px] font-bold shrink-0">Check-in</button>
                                </div>
                              ))}
                            </div>
                          </div>
                        </div>
                      );
                    })}
                  </div>
                )}
              </section>
            )}

            {/* ============================================================== */}
            {/* VIEW 03: KEY RESULTS MANAGEMENT                                */}
            {/* ============================================================== */}
            {activeTab === 'key-results' && (
              <section className="flex-1 min-h-0 p-4 sm:p-6 space-y-5 overflow-y-auto">
                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div>
                    <h1 className="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2.5">
                      <span className="w-8 h-8 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-500 text-white flex items-center justify-center shadow-sm">
                        <CheckCircle2 className="w-4 h-4" />
                      </span>
                      <span>{t.krPageTitle}</span>
                    </h1>
                    <p className="text-xs sm:text-sm text-slate-600 mt-1">{t.krPageSub}</p>
                  </div>
                  <button onClick={() => openKrModal()} className="flex items-center gap-2 bg-gradient-to-r from-emerald-600 to-teal-600 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-md">
                    <Plus className="w-4 h-4" />
                    <span>{t.addKrBtn}</span>
                  </button>
