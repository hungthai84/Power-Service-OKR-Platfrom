                                  </div>
                                  <div className="flex items-center justify-between mt-2 text-[10px] text-slate-500">
                                    <span className="px-1.5 py-0.5 rounded bg-slate-100 font-bold">{task.priority || 'MEDIUM'}</span>
                                    <span>{formatLocaleDate(task.dueDate)}</span>
                                  </div>
                                </div>
                              ))}
                            </div>
                          </div>
                          <button onClick={() => openAddTaskModal(col.key)} className="mt-3 w-full py-1.5 rounded-xl text-[11px] font-bold text-slate-600 hover:text-indigo-700 hover:bg-white/80 flex items-center justify-center gap-1">
                            <Plus className="w-3 h-3" />
                            <span>+ Thêm</span>
                          </button>
                        </div>
                      );
                    })}
                  </div>
                </div>
              </main>
            )}

            {/* ============================================================== */}
            {/* VIEW 02: OBJECTIVES MANAGEMENT                                 */}
            {/* ============================================================== */}
            {activeTab === 'objectives' && (
              <section className="flex-1 min-h-0 p-4 sm:p-6 space-y-5 overflow-y-auto">
                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div>
                    <h1 className="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2.5">
                      <span className="w-8 h-8 rounded-xl bg-gradient-to-tr from-blue-600 to-fuchsia-500 text-white flex items-center justify-center shadow-sm">
                        <Compass className="w-4 h-4" />
                      </span>
                      <span>{t.objPageTitle}</span>
                    </h1>
                    <p className="text-xs sm:text-sm text-slate-600 mt-1">{t.objPageSub}</p>
                  </div>

                  <div className="flex flex-wrap items-center gap-2">
                    <div className="glass-card p-1 rounded-xl flex items-center gap-1">
                      {['card', 'table', 'hierarchy'].map(m => (
                        <button key={m} onClick={() => setObjViewMode(m)} className={`px-2.5 py-1.5 rounded-lg text-xs font-bold capitalize ${objViewMode === m ? 'bg-indigo-600 text-white' : 'text-slate-700 hover:bg-white/80'}`}>
                          {m === 'hierarchy' ? 'Tree' : m}
                        </button>
                      ))}
                    </div>

                    <label className="glass-card px-3 py-2 rounded-xl flex items-center gap-1.5 text-xs font-bold text-slate-700 cursor-pointer">
                      <input type="checkbox" checked={showDeletedObj} onChange={(e) => setShowDeletedObj(e.target.checked)} className="accent-indigo-600" />
                      <span>{t.showTrash}</span>
                    </label>

                    <button onClick={() => openAddOkrModal()} className="flex items-center gap-2 bg-gradient-to-r from-blue-600 via-indigo-600 to-fuchsia-600 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-md">
                      <PlusCircle className="w-4 h-4" />
                      <span>{t.addObjectiveBtn}</span>
                    </button>
                  </div>
                </div>

                {/* Filter Bar */}
                <div className="glass-card p-4 rounded-2xl flex flex-col lg:flex-row lg:items-center justify-between gap-3">
                  <div className="flex flex-wrap items-center gap-1.5">
                    <button onClick={() => setSelectedDeptTab('ALL')} className={`px-3 py-1.5 rounded-xl text-xs font-bold ${selectedDeptTab === 'ALL' ? 'bg-indigo-600 text-white' : 'bg-white/80 text-slate-700'}`}>
                      {t.allDepartments}
                    </button>
                    {db.departments.map(d => (
                      <button key={d.departmentId} onClick={() => setSelectedDeptTab(d.departmentId)} className={`px-3 py-1.5 rounded-xl text-xs font-bold ${selectedDeptTab === d.departmentId ? 'bg-indigo-600 text-white' : 'bg-white/80 text-slate-700'}`}>
                        {getRawLocalized(d, 'name')}
                      </button>
                    ))}
                  </div>

                  <div className="flex flex-wrap items-center gap-2">
                    <select value={objLevelFilter} onChange={(e) => setObjLevelFilter(e.target.value)} className="text-xs font-bold text-slate-700 bg-white/85 border border-white rounded-xl px-3 py-1.5 outline-none">
