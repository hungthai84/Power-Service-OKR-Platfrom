    });
  }, [db.objectives, searchQuery, selectedCycleId, dashDeptFilter, dashStatusFilter]);

  const dashboardMetrics = useMemo(() => {
    const activeObjs = filteredDashboardObjectives;
    const objIds = new Set(activeObjs.map(o => o.objectiveId));
    const activeKrs = db.keyResults.filter(k => !k.deletedAt && (objIds.has(k.objectiveId) || db.objectives.length === 0));
    const activeInits = db.initiatives.filter(i => !i.deletedAt);

    const totalObjs = activeObjs.length;
    const completedKrs = activeKrs.filter(k => Number(k.progress) >= 100 || k.status === 'COMPLETED').length;
    const onTrackObjs = activeObjs.filter(o => o.status === 'ON_TRACK' || o.status === 'COMPLETED').length;
    const atRiskObjs = activeObjs.filter(o => o.status === 'AT_RISK').length;
    const behindObjs = activeObjs.filter(o => o.status === 'BEHIND' || o.status === 'NOT_STARTED').length;
    const overdueTasks = activeInits.filter(i => i.status !== 'DONE' && i.dueDate && new Date(i.dueDate) < new Date()).length;

    const sevenDaysAgo = Date.now() - 7 * 86400000;
    const recentCheckedKrs = activeKrs.filter(k => k.lastCheckinAt && new Date(k.lastCheckinAt).getTime() >= sevenDaysAgo).length;
    const checkinRate = activeKrs.length > 0 ? Math.round((recentCheckedKrs / activeKrs.length) * 100) : 0;

    const avgPct = totalObjs > 0 ? activeObjs.reduce((s, o) => s + (Number(o.progress) || 0), 0) / totalObjs : 0;
    const avgScore = (avgPct / 100).toFixed(2);

    return {
      totalObjs,
      allActiveObjsCount: db.objectives.filter(o => !o.deletedAt).length,
      completedKrs,
      totalKrs: activeKrs.length,
      onTrackObjs,
      atRiskObjs,
      behindObjs,
      overdueTasks,
      checkinRate,
      avgScore
    };
  }, [filteredDashboardObjectives, db.keyResults, db.initiatives, db.objectives]);

