                </button>

                {/* User Profile */}
                <div className="flex items-center gap-2.5 pl-2.5 border-l border-white/75 shrink-0">
                  <div className="relative">
                    <img src={currentUser.avatarUrl} alt="User" className="w-8 h-8 rounded-full object-cover ring-2 ring-white" />
                    <span className="w-2.5 h-2.5 rounded-full bg-emerald-500 ring-2 ring-white absolute -bottom-0.5 -right-0.5" />
                  </div>
                  <div className="hidden md:block text-left">
                    <p className="text-[13px] font-bold text-slate-800 leading-tight whitespace-nowrap flex items-center gap-1">
                      <span>{lang === 'ko' ? currentUser.displayNameKo : currentUser.displayNameVi}</span>
                      <Sparkles className="w-3 h-3 text-amber-500" />
                    </p>
                    <p className="text-[12px] text-slate-600 whitespace-nowrap">{currentUser.role} • FlowOKR</p>
                  </div>
                </div>
              </div>
            </header>

            {/* ============================================================== */}
            {/* VIEW 01: DASHBOARD                                             */}
            {/* ============================================================== */}
            {activeTab === 'dashboard' && (
              <main className="flex-1 min-h-0 p-4 sm:p-6 space-y-5 overflow-y-auto">
                {/* Header & Filters */}
                <div className="flex flex-col xl:flex-row xl:items-center justify-between gap-3">
                  <div>
                    <h1 className="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2">
                      <span>{t.dashGreeting}</span>
                      <span>🎯</span>
                    </h1>
                    <p className="text-xs sm:text-sm text-slate-600 mt-0.5">{t.dashSubtitle}</p>
                  </div>

                  <div className="flex flex-wrap items-center gap-2">
                    <div className="glass-card rounded-xl px-3 py-1.5 flex items-center gap-2">
                      <Calendar className="w-3.5 h-3.5 text-indigo-600" />
                      <select value={selectedCycleId} onChange={(e) => setSelectedCycleId(e.target.value)} className="text-xs font-bold text-slate-700 bg-transparent outline-none cursor-pointer">
                        <option value="ALL">{t.allCycles}</option>
                        {db.cycles.map(c => (
                          <option key={c.cycleId} value={c.cycleId}>{getRawLocalized(c, 'name')} ({c.status})</option>
                        ))}
                      </select>
                    </div>

                    <div className="glass-card rounded-xl px-3 py-1.5 flex items-center gap-2">
                      <Building2 className="w-3.5 h-3.5 text-fuchsia-600" />
                      <select value={dashDeptFilter} onChange={(e) => setDashDeptFilter(e.target.value)} className="text-xs font-bold text-slate-700 bg-transparent outline-none cursor-pointer">
                        <option value="ALL">{t.allDepartments}</option>
                        {db.departments.map(d => (
                          <option key={d.departmentId} value={d.departmentId}>{getRawLocalized(d, 'name')}</option>
                        ))}
                      </select>
                    </div>

                    <div className="glass-card rounded-xl px-3 py-1.5 flex items-center gap-2">
                      <Filter className="w-3.5 h-3.5 text-emerald-600" />
                      <select value={dashStatusFilter} onChange={(e) => setDashStatusFilter(e.target.value)} className="text-xs font-bold text-slate-700 bg-transparent outline-none cursor-pointer">
                        <option value="ALL">{t.allStatuses}</option>
                        <option value="ON_TRACK">ON TRACK</option>
                        <option value="AT_RISK">AT RISK</option>
                        <option value="BEHIND">BEHIND</option>
                        <option value="COMPLETED">COMPLETED</option>
                      </select>
                    </div>
                  </div>
                </div>

                {/* Empty Database Prompt */}
                {dashboardMetrics.allActiveObjsCount === 0 && (
                  <div className="glass-card border-indigo-200 bg-gradient-to-r from-blue-500/10 via-indigo-500/10 to-fuchsia-500/10 p-5 rounded-2xl flex flex-col sm:flex-row items-center justify-between gap-4">
                    <div className="flex items-center gap-3.5">
                      <div className="w-11 h-11 rounded-2xl bg-indigo-600 text-white flex items-center justify-center shrink-0 shadow-md">
                        <DatabaseZap className="w-5 h-5" />
                      </div>
                      <div>
                        <h3 className="text-sm font-bold text-slate-900">{t.emptyDbTitle}</h3>
                        <p className="text-xs text-slate-600 mt-0.5">{t.emptyDbDesc}</p>
                      </div>
                    </div>
                    <div className="flex items-center gap-2 shrink-0">
                      <button onClick={() => openAddOkrModal()} className="px-3.5 py-2 rounded-xl bg-white text-indigo-700 border border-indigo-200 text-xs font-bold hover:bg-indigo-50">
                        {t.createFirstOkr}
                      </button>
                      <button onClick={async () => { await callBackend('seedDemoData'); showToast('Đã nạp dữ liệu mẫu doanh nghiệp!'); }} className="px-3.5 py-2 rounded-xl bg-indigo-600 text-white text-xs font-bold hover:bg-indigo-700 shadow-sm">
                        {t.seedDemoBtn}
                      </button>
                    </div>
                  </div>
                )}

                {/* 4 KPI Cards */}
                <div className="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4 sm:gap-5">
                  <div className="card-light-glassmorphism p-5 rounded-2xl flex items-center gap-4 hover:-translate-y-0.5">
                    <div className="w-12 h-12 rounded-2xl bg-gradient-to-tr from-blue-600 to-cyan-500 text-white flex items-center justify-center shrink-0 shadow-md shadow-blue-500/25">
                      <Target className="w-6 h-6" />
                    </div>
                    <div>
                      <p className="text-xs font-bold text-slate-600">{t.kpiActiveObjectives}</p>
                      <div className="flex items-baseline gap-2 mt-0.5">
                        <span className="text-2xl font-bold text-slate-900">{dashboardMetrics.totalObjs}</span>
                        <span className="text-xs font-bold text-blue-700">{dashboardMetrics.allActiveObjsCount} tổng</span>
                      </div>
                      <p className="text-[11px] text-slate-600 mt-0.5">{dashboardMetrics.overdueTasks} {lang === 'ko' ? '지연 과제' : 'công việc quá hạn'}</p>
                    </div>
                  </div>

                  <div className="card-light-glassmorphism p-5 rounded-2xl flex items-center gap-4 hover:-translate-y-0.5">
                    <div className="w-12 h-12 rounded-2xl bg-gradient-to-tr from-emerald-500 to-teal-400 text-white flex items-center justify-center shrink-0 shadow-md shadow-emerald-500/25">
                      <CheckCircle className="w-6 h-6" />
                    </div>
                    <div>
                      <p className="text-xs font-bold text-slate-600">{t.kpiCompletedKrs}</p>
                      <div className="flex items-baseline gap-2 mt-0.5">
                        <span className="text-2xl font-bold text-slate-900">{dashboardMetrics.completedKrs}</span>
                        <span className="text-xs font-bold text-emerald-700">/ {dashboardMetrics.totalKrs} KRs</span>
                      </div>
                      <p className="text-[11px] text-slate-600 mt-0.5">{dashboardMetrics.onTrackObjs} OKR On Track</p>
                    </div>
                  </div>

                  <div className="card-light-glassmorphism p-5 rounded-2xl flex items-center gap-4 hover:-translate-y-0.5">
                    <div className="w-12 h-12 rounded-2xl bg-gradient-to-tr from-amber-500 to-orange-500 text-white flex items-center justify-center shrink-0 shadow-md shadow-amber-500/25">
                      <AlertTriangle className="w-6 h-6" />
                    </div>
                    <div>
                      <p className="text-xs font-bold text-slate-600">{t.kpiAtRiskOkrs}</p>
                      <div className="flex items-baseline gap-2 mt-0.5">
                        <span className="text-2xl font-bold text-slate-900">{dashboardMetrics.atRiskObjs + dashboardMetrics.behindObjs}</span>
                        <span className="text-xs font-bold text-rose-700">{dashboardMetrics.behindObjs} Behind</span>
                      </div>
                      <p className="text-[11px] text-slate-600 mt-0.5">{t.kpiNeedsAttention}</p>
                    </div>
                  </div>

                  <div className="card-light-glassmorphism p-5 rounded-2xl flex items-center gap-4 hover:-translate-y-0.5">
                    <div className="w-12 h-12 rounded-2xl bg-gradient-to-tr from-purple-600 to-fuchsia-500 text-white flex items-center justify-center shrink-0 shadow-md shadow-purple-500/25">
                      <Users className="w-6 h-6" />
                    </div>
                    <div>
                      <p className="text-xs font-bold text-slate-600">{t.kpiCheckinRate}</p>
                      <div className="flex items-baseline gap-2 mt-0.5">
                        <span className="text-2xl font-bold text-slate-900">{dashboardMetrics.checkinRate}%</span>
                        <span className="text-xs font-bold text-purple-700">{db.checkins.length} lượt</span>
                      </div>
                      <p className="text-[11px] text-slate-600 mt-0.5">{t.kpiCheckinSub}</p>
                    </div>
                  </div>
                </div>

                {/* Middle Bento Row: Objectives Progress, OKR Score Ring, Schedule */}
                <div className="grid grid-cols-1 lg:grid-cols-12 gap-5">
                  {/* Objectives Progress */}
                  <div className="lg:col-span-5 glass-card p-5 rounded-2xl flex flex-col justify-between">
                    <div>
                      <div className="flex items-center justify-between mb-4">
                        <div>
                          <h2 className="font-bold text-base text-slate-900">{t.dashObjProgressTitle}</h2>
                          <p className="text-xs text-slate-500 mt-0.5">{t.dashObjProgressSub}</p>
                        </div>
                        <button onClick={() => setActiveTab('objectives')} className="text-xs font-bold text-indigo-600 hover:text-indigo-700 bg-white/80 px-2.5 py-1 rounded-lg border border-white flex items-center gap-1">
                          <span>{t.viewAll}</span>
                          <ArrowRight className="w-3 h-3" />
                        </button>
                      </div>

                      <div className="space-y-3 max-h-[280px] overflow-y-auto pr-1">
                        {filteredDashboardObjectives.length === 0 ? (
                          <div className="p-6 text-center text-xs text-slate-500 bg-white/50 rounded-xl border border-white">
                            {lang === 'ko' ? '표시할 목표가 없습니다.' : 'Chưa có Mục tiêu OKR nào trong bộ lọc này.'}
                          </div>
                        ) : filteredDashboardObjectives.slice(0, 6).map(obj => {
                          const dept = db.departments.find(d => d.departmentId === obj.departmentId);
                          const barColor = obj.progress >= 70 ? 'from-blue-600 to-cyan-500' : obj.progress >= 40 ? 'from-amber-500 to-orange-500' : 'from-rose-500 to-fuchsia-500';
                          return (
                            <div key={obj.objectiveId} onClick={() => setDetailModalObjId(obj.objectiveId)} className="group cursor-pointer p-3 rounded-xl bg-white/70 hover:bg-white border border-white transition-all">
                              <div className="flex items-center justify-between gap-3 mb-1.5">
                                <div className="min-w-0">
                                  <div className="flex items-center gap-1.5 mb-0.5">
                                    <span className="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-500/15 text-indigo-700">{obj.level || 'Department'}</span>
                                    <span className="text-[10px] font-bold text-slate-500">{dept ? getRawLocalized(dept, 'name') : ''}</span>
                                  </div>
                                  <h3 className="text-xs sm:text-sm font-bold text-slate-800 truncate group-hover:text-indigo-600 transition-colors">
                                    {renderLocalized(obj, 'title')}
                                  </h3>
                                </div>
                                <span className="text-xs font-bold text-slate-900 shrink-0">{obj.progress || 0}%</span>
                              </div>
                              <div className="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                                <div className={`bg-gradient-to-r ${barColor} h-full rounded-full transition-all duration-500`} style={{ width: `${obj.progress || 0}%` }} />
                              </div>
                            </div>
                          );
                        })}
                      </div>
                    </div>
                  </div>

                  {/* OKR Overall Score SVG Ring */}
                  <div className="lg:col-span-3 glass-card p-5 rounded-2xl flex flex-col justify-between">
                    <div className="flex items-center justify-between mb-2">
                      <h2 className="font-bold text-base text-slate-900">{t.dashOkrScoreTitle}</h2>
                      <span className="text-xs font-bold px-2.5 py-0.5 rounded-full bg-indigo-500/15 text-indigo-700 border border-indigo-300/40">OKR</span>
                    </div>

                    {(() => {
                      const total = dashboardMetrics.onTrackObjs + dashboardMetrics.atRiskObjs + dashboardMetrics.behindObjs;
                      const onPct = total > 0 ? (dashboardMetrics.onTrackObjs / total) * 100 : 0;
                      const riskPct = total > 0 ? (dashboardMetrics.atRiskObjs / total) * 100 : 0;
                      const r = 56;
                      const circ = 2 * Math.PI * r;
                      return (
                        <div className="relative w-40 h-40 mx-auto my-2 flex items-center justify-center">
                          <svg className="w-full h-full -rotate-90" viewBox="0 0 140 140">
                            <circle cx="70" cy="70" r={r} fill="none" stroke="#e2e8f0" strokeWidth="14" />
                            {total > 0 && (
                              <>
                                <circle cx="70" cy="70" r={r} fill="none" stroke="#4f46e5" strokeWidth="14" strokeDasharray={`${(onPct / 100) * circ} ${circ}`} strokeLinecap="round" />
                                <circle cx="70" cy="70" r={r} fill="none" stroke="#f59e0b" strokeWidth="14" strokeDasharray={`${(riskPct / 100) * circ} ${circ}`} strokeDashoffset={-((onPct / 100) * circ)} />
                              </>
                            )}
                          </svg>
                          <div className="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                            <span className="text-2xl font-bold text-slate-900">{dashboardMetrics.avgScore}</span>
                            <span className="text-[11px] text-slate-500">{t.avgScore}</span>
                          </div>
                        </div>
                      );
                    })()}

                    <div className="space-y-2 mt-2 pt-2.5 border-t border-white/80 text-xs">
                      <div className="flex items-center justify-between">
                        <div className="flex items-center gap-2"><span className="w-2.5 h-2.5 rounded-full bg-indigo-600" /><span className="text-slate-600">On Track</span></div>
                        <span className="font-bold text-slate-800">{dashboardMetrics.onTrackObjs}</span>
                      </div>
                      <div className="flex items-center justify-between">
                        <div className="flex items-center gap-2"><span className="w-2.5 h-2.5 rounded-full bg-amber-400" /><span className="text-slate-600">At Risk</span></div>
                        <span className="font-bold text-slate-800">{dashboardMetrics.atRiskObjs}</span>
                      </div>
                      <div className="flex items-center justify-between">
                        <div className="flex items-center gap-2"><span className="w-2.5 h-2.5 rounded-full bg-rose-500" /><span className="text-slate-600">Behind / Not Started</span></div>
                        <span className="font-bold text-slate-800">{dashboardMetrics.behindObjs}</span>
                      </div>
                    </div>
                  </div>

                  {/* Check-in Schedule */}
                  <div className="lg:col-span-4 glass-card p-5 rounded-2xl flex flex-col justify-between">
                    <div>
                      <div className="flex items-center justify-between mb-3">
                        <h2 className="font-bold text-base text-slate-900">{t.dashCheckinSchedTitle}</h2>
                        <button onClick={() => setActiveTab('calendar')} className="text-xs font-bold text-indigo-600 hover:text-indigo-700 flex items-center gap-1">
                          <span>{t.viewCalendar}</span>
                          <ArrowRight className="w-3.5 h-3.5" />
                        </button>
                      </div>

                      <div className="grid grid-cols-7 gap-1 text-center mb-4">
                        {[-2, -1, 0, 1, 2, 3, 4].map(offset => {
                          const d = new Date();
                          d.setDate(d.getDate() + offset);
                          const isToday = offset === 0;
                          const dayLabels = lang === 'ko' ? ['일', '월', '화', '수', '목', '금', '토'] : ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];
                          return (
                            <div key={offset} className={`py-1.5 rounded-xl text-[11px] ${isToday ? 'bg-gradient-to-b from-blue-600 to-indigo-600 text-white shadow-md' : 'text-slate-500'}`}>
                              {dayLabels[d.getDay()]}
                              <span className={`block text-xs font-bold mt-0.5 ${isToday ? 'text-white' : 'text-slate-700'}`}>{d.getDate()}</span>
                            </div>
                          );
                        })}
                      </div>

                      <div className="space-y-2.5 max-h-[200px] overflow-y-auto pr-1">
                        {db.objectives.filter(o => !o.deletedAt && o.dueDate).slice(0, 4).map(o => (
                          <div key={o.objectiveId} className="p-2.5 rounded-xl bg-white/75 border border-white flex items-center justify-between gap-2">
                            <div className="flex items-start gap-2 min-w-0">
                              <span className={`w-2 h-2 rounded-full mt-1.5 shrink-0 ${o.status === 'AT_RISK' ? 'bg-amber-500' : 'bg-indigo-600'}`} />
                              <div className="min-w-0">
                                <p className="text-xs font-bold text-slate-800 truncate">{getRawLocalized(o, 'title')}</p>
                                <p className="text-[11px] text-slate-500">{formatLocaleDate(o.dueDate)}</p>
                              </div>
                            </div>
                          </div>
                        ))}
                        {db.objectives.filter(o => !o.deletedAt).length === 0 && (
                          <p className="text-xs text-slate-500 text-center py-4">{lang === 'ko' ? '예정된 일정이 없습니다.' : 'Chưa có lịch Check-in sắp tới.'}</p>
                        )}
                      </div>
                    </div>
                  </div>
                </div>

                {/* Department Performance & Activity Bar Chart */}
                <div className="grid grid-cols-1 lg:grid-cols-12 gap-5">
                  <div className="lg:col-span-5 glass-card p-5 rounded-2xl">
                    <div className="flex items-center justify-between mb-4">
                      <h2 className="font-bold text-base text-slate-900">{t.dashDeptPerfTitle}</h2>
                      <button onClick={() => setActiveTab('team')} className="text-xs font-bold text-indigo-600 hover:text-indigo-700 flex items-center gap-1">
                        <span>{t.viewAll}</span>
                        <ArrowRight className="w-3.5 h-3.5" />
                      </button>
                    </div>
                    <div className="space-y-3 max-h-[220px] overflow-y-auto pr-1">
                      {db.departments.map(dept => {
                        const deptObjs = db.objectives.filter(o => !o.deletedAt && o.departmentId === dept.departmentId);
                        const avg = deptObjs.length > 0 ? Math.round(deptObjs.reduce((s, o) => s + (Number(o.progress) || 0), 0) / deptObjs.length) : 0;
                        return (
                          <div key={dept.departmentId} className="p-2.5 rounded-xl bg-white/70 border border-white">
                            <div className="flex items-center justify-between text-xs mb-1.5">
                              <div>
                                <span className="font-bold text-slate-800">{renderLocalized(dept, 'name')}</span>
                                <span className="text-[11px] text-slate-500 ml-1.5">({deptObjs.length} OKRs)</span>
                              </div>
                              <span className="font-bold text-indigo-700">{avg}%</span>
                            </div>
                            <div className="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden">
                              <div className="h-full bg-gradient-to-r from-indigo-600 to-fuchsia-500 rounded-full" style={{ width: `${avg}%` }} />
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>

                  {/* Interactive Bar Chart */}
                  <div className="lg:col-span-7 glass-card p-5 rounded-2xl flex flex-col justify-between">
                    <div className="flex items-center justify-between mb-3">
                      <div>
                        <h2 className="font-bold text-base text-slate-900">{t.dashActivityChartTitle}</h2>
                        <p className="text-xs text-slate-500 mt-0.5">{t.dashActivityChartSub}</p>
                      </div>
                      <select value={dashChartMode} onChange={(e) => setDashChartMode(e.target.value)} className="text-xs font-bold text-slate-700 bg-white/85 border border-white rounded-xl px-3 py-1.5 outline-none">
                        <option value="weekly">{t.chartModeWeekly}</option>
                        <option value="department">{t.chartModeDept}</option>
                      </select>
                    </div>
                    <div className="h-48 flex items-end justify-around gap-3 pt-6 px-2 border-b border-slate-200/70">
                      {(() => {
                        const maxVal = Math.max(5, ...weeklyBarData.map(b => b.value));
                        return weeklyBarData.map((bar, idx) => {
                          const heightPct = Math.max(8, Math.round((bar.value / maxVal) * 100));
                          return (
                            <div key={idx} className="flex-1 flex flex-col items-center gap-1.5 h-full justify-end">
                              <span className="text-[11px] font-bold text-indigo-700">{bar.value}{bar.suffix}</span>
                              <div className="w-full max-w-[36px] bg-gradient-to-t from-blue-600 to-indigo-500 rounded-t-lg transition-all duration-500 shadow-xs" style={{ height: `${heightPct}%` }} />
                              <span className="text-[11px] font-bold text-slate-600 truncate max-w-[75px]">{bar.label}</span>
                            </div>
                          );
                        });
                      })()}
                    </div>
                  </div>
                </div>

                {/* Kanban Preview */}
                <div className="glass-card p-5 rounded-2xl">
                  <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
                    <div className="flex items-center gap-2.5">
                      <div className="w-8 h-8 rounded-xl bg-gradient-to-tr from-indigo-500 to-fuchsia-500 text-white flex items-center justify-center shadow-sm">
                        <Kanban className="w-4 h-4" />
                      </div>
                      <div>
                        <h2 className="font-bold text-base text-slate-900">{t.dashKanbanTitle}</h2>
                        <p className="text-xs text-slate-500">{t.dashKanbanSub}</p>
                      </div>
                    </div>
                    <div className="flex items-center gap-2">
                      <button onClick={() => setActiveTab('kanban')} className="text-xs font-bold text-slate-700 hover:text-indigo-700 bg-white/85 px-3 py-1.5 rounded-xl border border-white">
                        {t.fullKanbanBtn}
                      </button>
                      <button onClick={() => openAddTaskModal('TO_DO')} className="text-xs font-bold text-white bg-indigo-600 hover:bg-indigo-700 px-3 py-1.5 rounded-xl flex items-center gap-1">
                        <Plus className="w-3.5 h-3.5" />
                        <span>{t.addInitiativeBtn}</span>
                      </button>
                    </div>
                  </div>

                  <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4">
                    {[
                      { key: 'TO_DO', title: 'TO DO', bg: 'from-indigo-500/10 to-white/60' },
                      { key: 'IN_PROGRESS', title: 'IN PROGRESS', bg: 'from-cyan-500/10 to-white/60' },
                      { key: 'REVIEW', title: 'REVIEW', bg: 'from-fuchsia-500/10 to-white/60' },
                      { key: 'DONE', title: 'DONE', bg: 'from-emerald-500/10 to-white/60' }
                    ].map(col => {
                      const items = db.initiatives.filter(i => !i.deletedAt && i.status === col.key);
                      return (
                        <div key={col.key} onDragOver={(e) => e.preventDefault()} onDrop={(e) => handleKanbanDrop(e, col.key)} className={`bg-gradient-to-b ${col.bg} p-3 rounded-2xl border border-white flex flex-col justify-between min-h-[220px]`}>
                          <div>
                            <div className="flex items-center justify-between mb-2.5 px-1">
                              <span className="text-xs font-bold text-slate-800">{col.title}</span>
                              <span className="px-2 py-0.5 rounded-full text-[11px] font-bold bg-white text-indigo-700">{items.length}</span>
                            </div>
                            <div className="space-y-2">
                              {items.map(task => (
                                <div key={task.initiativeId} draggable onDragStart={(e) => e.dataTransfer.setData('text/plain', task.initiativeId)} className="bg-white/90 hover:bg-white p-3 rounded-xl border border-white shadow-2xs cursor-grab">
                                  <div className="flex items-start justify-between gap-2">
                                    <p className="text-xs font-bold text-slate-800 leading-snug">{renderLocalized(task, 'title')}</p>
