    }
  };

  const handleCloneObjective = async (src) => {
    setLoadingText('Đang nhân bản Objective...');
    try {
      await callBackend('saveObjective', {
        data: {
          titleVi: `${src.titleVi} (Bản sao)`,
          titleKo: src.titleKo ? `${src.titleKo} (복사본)` : '',
          descriptionVi: src.descriptionVi || '',
          descriptionKo: src.descriptionKo || '',
          cycleId: src.cycleId,
          level: src.level,
          departmentId: src.departmentId,
          ownerId: src.ownerId,
          parentObjectiveId: src.parentObjectiveId || '',
          weight: src.weight || 100,
          startDate: src.startDate,
          dueDate: src.dueDate
        }
      });
      await syncAllData();
      showToast('Đã nhân bản Mục tiêu thành công!');
    } catch (err) {
      showToast(err.message, 'error');
    } finally {
      setLoadingText('');
    }
  };

  const handleDeleteOrRestoreObjective = (obj, isRestore) => {
    setConfirmDialog({
      open: true,
      title: isRestore ? 'Khôi phục Mục tiêu' : 'Xóa mềm Mục tiêu (Soft Delete)',
      message: isRestore
        ? `Bạn có chắc muốn khôi phục mục tiêu "${getRawLocalized(obj, 'title')}"?`
        : `Mục tiêu "${getRawLocalized(obj, 'title')}" sẽ được chuyển vào Thùng rác và có thể khôi phục bất cứ lúc nào.`,
      onConfirm: async () => {
        setConfirmDialog({ open: false, title: '', message: '', onConfirm: null });
        setLoadingText(isRestore ? 'Đang khôi phục...' : 'Đang chuyển vào thùng rác...');
        try {
          await callBackend('deleteObjective', { objectiveId: obj.objectiveId, restore: isRestore });
          await syncAllData();
          showToast(isRestore ? 'Đã khôi phục Mục tiêu!' : 'Đã chuyển Mục tiêu vào thùng rác!');
        } catch (err) {
          showToast(err.message, 'error');
        } finally {
          setLoadingText('');
        }
      }
    });
  };

  const openKrModal = (objectiveId = '', kr = null) => {
    const activeObjs = db.objectives.filter(o => !o.deletedAt);
    setKrModal({
      open: true,
      data: kr ? { ...kr } : {
        krId: '',
        objectiveId: objectiveId || activeObjs[0]?.objectiveId || '',
        titleVi: '',
        titleKo: '',
        metricType: 'NUMBER',
        direction: 'INCREASE',
        unit: '%',
        weight: 1,
        baselineValue: 0,
        currentValue: 0,
        targetValue: 100,
        minTargetValue: '',
        maxTargetValue: '',
        ownerId: currentUser.userId,
        dataSourceUrl: ''
      }
    });
  };

  const handleSaveKrSubmit = async (e) => {
    e.preventDefault();
    setLoadingText('Đang lưu Key Result...');
    try {
      await callBackend('saveKeyResult', {
        data: { ...krModal.data, krId: krModal.data.krId || undefined }
      });
      setKrModal({ open: false, data: null });
      await syncAllData();
      showToast('Đã lưu Key Result và cập nhật điểm Objective!');
    } catch (err) {
      showToast(err.message, 'error');
    } finally {
      setLoadingText('');
    }
  };

  const openCheckInModal = (kr) => {
    if (!kr) return;
    setCheckinModal({
      open: true,
      kr,
      currentValue: kr.currentValue,
      confidence: 8,
      status: kr.status === 'NOT_STARTED' ? 'ON_TRACK' : (kr.status || 'ON_TRACK'),
      winsVi: '',
      winsKo: '',
      blockersVi: '',
      nextStepsVi: '',
      evidenceUrl: ''
    });
  };

  const handleCheckInSubmit = async (e) => {
    e.preventDefault();
    const { kr, currentValue, confidence, status, winsVi, winsKo, blockersVi, nextStepsVi, evidenceUrl } = checkinModal;
    setLoadingText('Đang ghi nhận Check-in vào Google Sheets...');
    try {
      await callBackend('createCheckIn', {
        data: {
          krId: kr.krId,
          objectiveId: kr.objectiveId,
          cycleId: selectedCycleId !== 'ALL' ? selectedCycleId : (db.cycles[0]?.cycleId || 'CYC-2026-Q4'),
          currentValue: Number(currentValue),
          confidenceScore: Number(confidence) || 8,
          status,
          winsVi,
          winsKo,
          blockersVi,
          nextStepsVi,
          evidenceUrl
        }
      });
      setCheckinModal(prev => ({ ...prev, open: false }));
      await syncAllData();
      showToast('Đã lưu Check-in thành công và đồng bộ điểm OKR!');
    } catch (err) {
      showToast(err.message, 'error');
    } finally {
      setLoadingText('');
    }
  };

  const openAddTaskModal = (defaultStatus = 'TO_DO') => {
    const due = new Date();
    due.setDate(due.getDate() + 14);
    const activeObjs = db.objectives.filter(o => !o.deletedAt);
    setTaskModal({
      open: true,
      data: {
        initiativeId: '',
        titleVi: '',
        titleKo: '',
        objectiveId: activeObjs[0]?.objectiveId || '',
        krId: '',
        priority: 'MEDIUM',
        status: defaultStatus,
        dueDate: due.toISOString().slice(0, 10)
      }
    });
  };

  const handleSaveTaskSubmit = async (e) => {
    e.preventDefault();
    setLoadingText('Đang lưu Sáng kiến...');
    try {
      await callBackend('saveInitiative', {
        data: { ...taskModal.data, initiativeId: taskModal.data.initiativeId || undefined }
      });
      setTaskModal({ open: false, data: null });
      await syncAllData();
      showToast('Đã lưu Sáng kiến vào bảng Kanban!');
    } catch (err) {
      showToast(err.message, 'error');
    } finally {
      setLoadingText('');
    }
  };

  const handleAdvanceTask = async (task) => {
    const order = ['BACKLOG', 'TO_DO', 'IN_PROGRESS', 'REVIEW', 'DONE'];
    const idx = order.indexOf(task.status);
    const nextStatus = order[Math.min(idx + 1, order.length - 1)];
    await callBackend('updateInitiativeStatus', { initiativeId: task.initiativeId, status: nextStatus });
    await syncAllData();
    showToast(`Đã chuyển trạng thái Initiative sang ${nextStatus}`);
  };

  const handleKanbanDrop = async (e, targetStatus) => {
    e.preventDefault();
    const initiativeId = e.dataTransfer.getData('text/plain');
    if (!initiativeId) return;
    await callBackend('updateInitiativeStatus', { initiativeId, status: targetStatus });
    await syncAllData();
    showToast(`Đã cập nhật trạng thái Initiative sang ${targetStatus}`);
  };

  const renderStatusPill = (status) => {
    const map = {
      ON_TRACK: 'bg-emerald-500/15 text-emerald-700 border-emerald-300/50',
      COMPLETED: 'bg-blue-500/15 text-blue-700 border-blue-300/50',
      AT_RISK: 'bg-amber-500/15 text-amber-700 border-amber-300/50',
      BEHIND: 'bg-rose-500/15 text-rose-700 border-rose-300/50',
      NOT_STARTED: 'bg-slate-500/15 text-slate-700 border-slate-300/50',
      PAUSED: 'bg-purple-500/15 text-purple-700 border-purple-300/50'
    };
    const cls = map[status] || map.NOT_STARTED;
    return <span className={`px-2 py-0.5 rounded-full text-[10px] font-bold border ${cls}`}>{status || 'NOT_STARTED'}</span>;
  };

  const exportReportCsv = (headers, rows, filename) => {
    if (!rows.length) {
      showToast('Không có dữ liệu báo cáo để xuất CSV', 'error');
      return;
    }
    const csvLines = [
      headers.map(h => `"${String(h).replace(/"/g, '""')}"`).join(','),
      ...rows.map(r => r.map(c => `"${String(c).replace(/"/g, '""')}"`).join(','))
    ];
    const blob = new Blob(['\uFEFF' + csvLines.join('\n')], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = filename;
    a.click();
    URL.revokeObjectURL(url);
    showToast('Đã xuất tệp CSV báo cáo thành công!');
  };

  // Navigation items (4-word bold style preserved)
  const navItems = [
    { key: 'dashboard', label: t.navDashboard, icon: LayoutDashboard },
    { key: 'objectives', label: t.navObjectives, icon: Compass },
    { key: 'key-results', label: t.navKeyResults, icon: CheckCircle2 },
    { key: 'checkins', label: t.navCheckins, icon: Activity },
    { key: 'kanban', label: t.navKanban, icon: Kanban },
    { key: 'alignment', label: t.navAlignment, icon: GitFork },
    { key: 'reports', label: t.navReports, icon: BarChart3 },
    { key: 'team', label: t.navTeam, icon: Users },
    { key: 'calendar', label: t.navCalendar, icon: CalendarDays },
    { key: 'templates', label: t.navTemplates, icon: BookOpen },
    { key: 'cycles', label: t.navCycles, icon: Repeat },
    { key: 'settings', label: t.navSettings, icon: Settings },
    { key: 'guide', label: t.navGuide, icon: HelpCircle }
  ];

  // Report Builder Data
  const reportDataset = useMemo(() => {
    const activeObjs = db.objectives.filter(o => !o.deletedAt);
    const activeKrs = db.keyResults.filter(k => !k.deletedAt);
    if (reportType === 'DEPARTMENT_OKR') {
      return {
        headers: ['Department ID', 'Phòng ban', 'Số Objectives', 'Điểm trung bình (%)', 'Đúng tiến độ'],
        rows: db.departments.map(d => {
          const objs = activeObjs.filter(o => o.departmentId === d.departmentId);
          const avg = objs.length ? Math.round(objs.reduce((s, o) => s + (Number(o.progress) || 0), 0) / objs.length) : 0;
          const onTrack = objs.filter(o => o.status === 'ON_TRACK' || o.status === 'COMPLETED').length;
          return [d.departmentId, getRawLocalized(d, 'name'), objs.length, `${avg}%`, onTrack];
        })
      };
    }
    if (reportType === 'KR_REPORT' || reportType === 'CHECKIN_COMPLIANCE') {
      return {
        headers: ['KR ID', 'Kết quả then chốt', 'Metric', 'Baseline', 'Current', 'Target', 'Tiến độ (%)', 'Last Check-in'],
        rows: activeKrs.map(k => [
          k.krId, getRawLocalized(k, 'title'), k.metricType, k.baselineValue, k.currentValue, k.targetValue, `${k.progress || 0}%`, formatLocaleDate(k.lastCheckinAt)
        ])
      };
    }
    if (reportType === 'AT_RISK_OKR' || reportType === 'OVERDUE_REPORT') {
      return {
        headers: ['Objective ID', 'Mục tiêu rủi ro / chậm', 'Cấp độ', 'Tiến độ (%)', 'Trạng thái', 'Deadline'],
        rows: activeObjs.filter(o => o.status === 'AT_RISK' || o.status === 'BEHIND').map(o => [
          o.objectiveId, getRawLocalized(o, 'title'), o.level, `${o.progress || 0}%`, o.status, formatLocaleDate(o.dueDate)
        ])
      };
    }
    return {
      headers: ['Objective ID', 'Tiêu đề Mục tiêu', 'Cấp độ', 'Phòng ban', 'Tiến độ (%)', 'Trạng thái', 'Deadline'],
      rows: activeObjs.map(o => {
        const dept = db.departments.find(d => d.departmentId === o.departmentId);
        return [o.objectiveId, getRawLocalized(o, 'title'), o.level, dept ? getRawLocalized(dept, 'name') : '', `${o.progress || 0}%`, o.status, formatLocaleDate(o.dueDate)];
      })
    };
  }, [db, reportType, lang]);

  // Weekly Bar Chart Data
  const weeklyBarData = useMemo(() => {
    if (dashChartMode === 'department') {
      return db.departments.map(d => {
        const objs = db.objectives.filter(o => !o.deletedAt && o.departmentId === d.departmentId);
        const val = objs.length ? Math.round(objs.reduce((s, o) => s + (Number(o.progress) || 0), 0) / objs.length) : 0;
        return { label: getRawLocalized(d, 'name'), value: val, suffix: '%' };
      });
    }
    const arr = [];
    for (let i = 6; i >= 0; i--) {
      const d = new Date();
      d.setDate(d.getDate() - i);
      const isoPrefix = d.toISOString().slice(0, 10);
      const count = db.checkins.filter(c => (c.createdAt || '').startsWith(isoPrefix)).length;
      arr.push({
        label: d.toLocaleDateString(lang === 'ko' ? 'ko-KR' : 'vi-VN', { weekday: 'short' }),
        value: count,
        suffix: ''
      });
    }
    return arr;
  }, [dashChartMode, db.departments, db.objectives, db.checkins, lang]);

  const unreadNotifCount = db.notifications.filter(n => !n.isRead).length;
  const detailObj = detailModalObjId ? db.objectives.find(o => o.objectiveId === detailModalObjId) : null;

  // ==========================================================================
  // 9. RENDER UI (LIGHT FROSTED GLASS #68 + 15PX VIEWPORT FRAME + 100% TRANSPARENT HEADER)
  // ==========================================================================
  return (
    <div style={{ fontFamily: "'Play', sans-serif", colorScheme: 'light' }} className="antialiased text-slate-900 bg-gradient-to-br from-[#f8faff] via-[#fdf4ff] to-[#f0f9ff] h-screen overflow-hidden relative selection:bg-indigo-100 selection:text-indigo-900">
      <style>{`
        .card-light-glassmorphism, .glass-card {
          background: linear-gradient(145deg, rgba(255, 255, 255, 0.88) 0%, rgba(255, 255, 255, 0.68) 100%);
          backdrop-filter: blur(22px) saturate(165%);
          -webkit-backdrop-filter: blur(22px) saturate(165%);
          border: 1px solid rgba(255, 255, 255, 0.95);
          box-shadow: 0 18px 40px -12px rgba(99, 102, 241, 0.12), inset 0 1.5px 1px rgba(255, 255, 255, 1);
          color: #0f172a;
          transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), background 0.25s ease, box-shadow 0.25s ease;
        }
        .card-light-glassmorphism:hover, .glass-card:hover {
          background: linear-gradient(145deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.78) 100%);
          box-shadow: 0 22px 44px -12px rgba(99, 102, 241, 0.16), inset 0 1.5px 1.5px rgba(255, 255, 255, 1);
        }
        .glass-shell {
          background: transparent;
          border: 1px solid rgba(255, 255, 255, 0.9);
          box-shadow: 0 24px 54px -12px rgba(99, 102, 241, 0.12);
        }
        .glass-panel {
          background: linear-gradient(145deg, rgba(255, 255, 255, 0.85) 0%, rgba(255, 255, 255, 0.65) 100%);
          backdrop-filter: blur(22px) saturate(165%);
          -webkit-backdrop-filter: blur(22px) saturate(165%);
          border-color: rgba(255, 255, 255, 0.95);
        }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: rgba(148, 163, 184, 0.45); border-radius: 9999px; }
      `}</style>

      {/* Luminous Light Ambient Mesh Orbs */}
      <div className="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
        <div className="absolute -top-24 -left-20 w-[500px] h-[500px] rounded-full bg-gradient-to-tr from-sky-200/55 to-cyan-100/55 blur-3xl" />
        <div className="absolute top-1/4 right-10 w-[460px] h-[460px] rounded-full bg-gradient-to-bl from-fuchsia-200/45 to-purple-200/45 blur-3xl" />
        <div className="absolute -bottom-24 left-1/3 w-[540px] h-[540px] rounded-full bg-gradient-to-tr from-emerald-100/50 via-teal-100/45 to-amber-100/50 blur-3xl" />
      </div>

      {/* Toast Container */}
      <div className="fixed bottom-5 right-5 z-50 flex flex-col gap-2 pointer-events-none">
        {toasts.map(item => (
          <div key={item.id} className="pointer-events-auto bg-white/95 backdrop-blur-xl text-slate-800 border border-white text-xs font-bold px-4 py-3 rounded-xl shadow-lg flex items-center gap-2.5">
            <span className={`w-2 h-2 rounded-full ${item.type === 'error' ? 'bg-rose-500' : 'bg-emerald-500'}`} />
            <span>{item.message}</span>
          </div>
        ))}
      </div>

      {/* Global Loader */}
      {loadingText && (
        <div className="fixed inset-0 z-50 flex items-center justify-center bg-white/40 backdrop-blur-xs">
          <div className="glass-card px-6 py-4 rounded-2xl flex items-center gap-3 shadow-xl">
            <div className="w-5 h-5 border-2 border-indigo-600 border-t-transparent rounded-full animate-spin" />
            <span className="text-xs font-bold text-slate-800">{loadingText}</span>
          </div>
        </div>
      )}

      {/* 15px Viewport Frame */}
      <div className="p-[15px] h-screen overflow-hidden">
        <div className="h-full flex flex-col lg:flex-row max-w-[1680px] mx-auto glass-shell rounded-3xl overflow-hidden">

          {/* Mobile Drawer Backdrop */}
          {mobileSidebarOpen && (
            <div onClick={() => setMobileSidebarOpen(false)} className="fixed inset-0 bg-slate-900/25 backdrop-blur-xs z-30 lg:hidden" />
          )}

          {/* Left Sidebar */}
          <aside className={`fixed lg:static inset-y-0 left-0 z-40 w-64 h-full glass-panel border-r border-white/80 flex flex-col justify-between overflow-y-auto transform transition-transform duration-300 shrink-0 ${mobileSidebarOpen ? 'translate-x-0' : '-translate-x-full lg:translate-x-0'}`}>
            <div>
              {/* Brand Logo */}
              <div className="h-16 px-5 flex items-center justify-between border-b border-white/70 shrink-0">
                <div className="flex items-center gap-3">
                  <div className="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-fuchsia-500 flex items-center justify-center text-white shadow-md shadow-indigo-500/30">
                    <Target className="w-5 h-5" />
                  </div>
                  <div>
                    <span className="font-bold text-xl tracking-tight text-slate-900 block leading-none">
                      Flow<span className="bg-gradient-to-r from-blue-600 to-fuchsia-600 bg-clip-text text-transparent">OKR</span>
                    </span>
                    <span className={`text-[10px] font-bold flex items-center gap-1 mt-0.5 ${syncOk ? 'text-emerald-700' : 'text-rose-600'}`}>
                      <span className={`w-1.5 h-1.5 rounded-full ${syncOk ? 'bg-emerald-500' : 'bg-rose-500'}`} />
                      <span>{syncOk ? t.syncReady : t.syncError}</span>
                    </span>
                  </div>
                </div>
                <button onClick={() => setMobileSidebarOpen(false)} className="lg:hidden p-2 rounded-lg text-slate-500 hover:bg-white/60">
                  <X className="w-5 h-5" />
                </button>
              </div>

              {/* Navigation Links */}
              <nav className="p-3 space-y-1">
                {navItems.map(item => {
                  const IconComp = item.icon;
                  const isActive = activeTab === item.key;
                  return (
                    <button
                      key={item.key}
                      onClick={() => { setActiveTab(item.key); setMobileSidebarOpen(false); }}
                      className={`w-full flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-bold transition-all ${
                        isActive
                          ? 'bg-white/95 text-blue-600 shadow-xs border border-white'
                          : 'text-slate-700 hover:bg-white/70 hover:text-slate-900'
                      }`}
                    >
                      <IconComp className="w-4 h-4 stroke-[2.5] shrink-0" />
                      <span>{item.label}</span>
                    </button>
                  );
                })}
              </nav>
            </div>

            {/* Bottom Database Card */}
            <div className="p-3 shrink-0">
              <div className="rounded-2xl bg-gradient-to-br from-blue-600 via-indigo-600 to-fuchsia-600 border border-white/50 p-3.5 text-white shadow-lg shadow-indigo-500/20">
                <div className="flex items-center justify-between mb-1.5">
                  <div className="w-7 h-7 rounded-full bg-white/25 flex items-center justify-center">
                    <Database className="w-3.5 h-3.5 text-amber-300" />
                  </div>
                  <span className="text-[10px] bg-white/20 px-2 py-0.5 rounded-full font-bold">{lastSyncTime}</span>
                </div>
                <h4 className="font-bold text-xs mb-0.5">{t.dbCardTitle}</h4>
                <p className="text-[10px] text-white/90 leading-relaxed mb-2.5">{t.dbCardDesc}</p>
                <button onClick={syncAllData} className="w-full py-1.5 px-3 bg-white text-indigo-700 hover:bg-indigo-50 font-bold text-xs rounded-xl flex items-center justify-center gap-1.5 transition-colors shadow-sm">
                  <RefreshCw className="w-3.5 h-3.5" />
                  <span>{t.syncNowBtn}</span>
                </button>
              </div>
            </div>
          </aside>

          {/* Right Main Workspace */}
          <div className="flex-1 h-full flex flex-col bg-transparent min-w-0 overflow-hidden">

            {/* Top Header: 100% Transparent, 12px Rounded, Vivid Icons, +1px Font */}
            <header className="h-16 bg-transparent border border-white/75 rounded-[12px] mx-4 sm:mx-6 mt-3 px-4 sm:px-5 flex items-center justify-between gap-3 shrink-0 z-20">
              <div className="flex items-center gap-3 flex-1 max-w-md">
                <button onClick={() => setMobileSidebarOpen(true)} className="lg:hidden p-2 rounded-[12px] border border-white/80 bg-transparent text-slate-700 hover:bg-white/50">
                  <Menu className="w-5 h-5" />
                </button>
                <div className="relative flex-1">
                  <Search className="w-4 h-4 text-indigo-600 absolute left-3.5 top-1/2 -translate-y-1/2" />
                  <input
                    value={searchQuery}
                    onChange={(e) => setSearchQuery(e.target.value)}
                    type="text"
                    placeholder={t.searchPlaceholder}
                    className="w-full pl-10 pr-8 py-2 bg-transparent border border-white/80 focus:border-indigo-500 focus:bg-white/60 rounded-[12px] text-[13px] sm:text-[15px] outline-none transition-all placeholder:text-slate-500"
                  />
                  <Sparkles className="w-3.5 h-3.5 text-fuchsia-500 absolute right-3 top-1/2 -translate-y-1/2 pointer-events-none" />
                </div>
              </div>

              <div className="flex items-center gap-2 sm:gap-3 shrink-0">
                {/* Bilingual Switcher */}
                <div className="flex items-center gap-1 bg-transparent border border-white/85 rounded-[12px] p-1 shrink-0">
                  <Globe className="w-3.5 h-3.5 text-indigo-600 ml-1.5 hidden sm:block" />
                  <button
                    onClick={() => handleLanguageSwitch('vi')}
                    className={`px-2.5 py-1 rounded-[10px] text-[13px] font-bold whitespace-nowrap transition-all ${lang === 'vi' ? 'bg-indigo-600 text-white' : 'text-slate-700 hover:bg-white/50'}`}
                  >
                    🇻🇳 VI
                  </button>
                  <button
                    onClick={() => handleLanguageSwitch('ko')}
                    className={`px-2.5 py-1 rounded-[10px] text-[13px] font-bold whitespace-nowrap transition-all ${lang === 'ko' ? 'bg-indigo-600 text-white' : 'text-slate-700 hover:bg-white/50'}`}
                  >
                    🇰🇷 KO
                  </button>
                </div>

                {/* Role Switcher */}
                <div className="hidden xl:flex items-center gap-1.5 bg-transparent border border-white/85 rounded-[12px] px-2.5 py-1.5">
                  <ShieldCheck className="w-4 h-4 text-emerald-600 shrink-0" />
                  <select
                    value={currentUser.role}
                    onChange={(e) => {
                      setCurrentUser(prev => ({ ...prev, role: e.target.value }));
                      showToast(`Đã chuyển vai trò kiểm thử sang ${e.target.value}`);
                    }}
                    className="text-[13px] font-bold text-indigo-700 bg-transparent outline-none cursor-pointer"
                  >
                    <option value="ADMIN">ADMIN</option>
                    <option value="OKR_ADMIN">OKR ADMIN</option>
                    <option value="EXECUTIVE">EXECUTIVE</option>
                    <option value="MANAGER">MANAGER</option>
                    <option value="MEMBER">MEMBER</option>
                    <option value="VIEWER">VIEWER</option>
                  </select>
                </div>

                {/* Quick Create OKR Button */}
                {currentUser.role !== 'VIEWER' && (
                  <button
                    onClick={() => openAddOkrModal()}
                    className="hidden sm:flex items-center gap-1.5 bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-700 hover:to-indigo-700 text-white text-[13px] font-bold whitespace-nowrap px-3.5 py-2 rounded-[12px] shadow-md shadow-indigo-500/20 transition-all"
                  >
                    <Rocket className="w-4 h-4 text-amber-200" />
                    <span>{t.createOkrBtn}</span>
                  </button>
                )}

                {/* Notification Bell */}
                <button
                  onClick={() => setActiveTab('notifications')}
                  className="relative p-2.5 rounded-[12px] bg-transparent border border-white/80 text-indigo-600 hover:bg-white/50 transition-colors shrink-0"
                >
                  <Bell className="w-4 h-4" />
                  {unreadNotifCount > 0 && (
                    <span className="w-2 h-2 rounded-full bg-rose-500 absolute top-2 right-2 ring-2 ring-white" />
