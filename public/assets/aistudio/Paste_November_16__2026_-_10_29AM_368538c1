                        <span className="font-mono text-[11px]">{connectedSheetId}</span>
                      </div>
                    </div>

                    <div>
                      <label className="block text-xs font-bold text-slate-700 mb-1">Web App URL (Nếu chạy React độc lập bên ngoài Google Apps Script)</label>
                      <div className="flex gap-2">
                        <input value={urlInput} onChange={(e) => setUrlInput(e.target.value)} type="url" placeholder="https://script.google.com/macros/s/.../exec" className="flex-1 px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs outline-none" />
                        <button onClick={() => { setGasWebAppUrl(urlInput.trim()); localStorage.setItem('flowokr_gas_url', urlInput.trim()); showToast('Đã lưu Web App URL!'); syncAllData(); }} className="px-3.5 py-2 rounded-xl bg-indigo-600 text-white text-xs font-bold">
                          Lưu URL
                        </button>
                      </div>
                    </div>

                    <div className="grid grid-cols-2 gap-2.5 pt-2">
                      <button onClick={async () => { const res = await callBackend('testConnection'); setConnectedSheetId(res.spreadsheetId || 'Connected'); showToast('Kết nối Google Sheets thành công!'); }} className="px-3 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold flex items-center justify-center gap-1.5">
