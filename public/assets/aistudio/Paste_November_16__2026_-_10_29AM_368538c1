                      <span>{t.guidePrintBtn}</span>
                    </button>
                  </div>
                </div>

                <div className="glass-card p-3 rounded-2xl flex flex-wrap items-center gap-2">
                  {[
                    { key: 'ALL', label: 'Tất cả 5 giai đoạn' },
                    { key: 'SETUP', label: 'Giai đoạn 1: Google Sheets & Apps Script' },
                    { key: 'ORG', label: 'Giai đoạn 2: Chu kỳ, Phòng ban & Nhân sự' },
                    { key: 'OKR', label: 'Giai đoạn 3: Thiết lập Objectives & KRs' },
                    { key: 'CHECKIN', label: 'Giai đoạn 4: Vận hành Check-in & Kanban' },
                    { key: 'ADMIN', label: 'Giai đoạn 5: Báo cáo, Song ngữ & Bảo mật' }
                  ].map(tab => (
                    <button key={tab.key} onClick={() => setGuideFilter(tab.key)} className={`px-3 py-1.5 rounded-xl text-xs font-bold ${guideFilter === tab.key ? 'bg-indigo-600 text-white' : 'bg-white/80 text-slate-700 hover:bg-white'}`}>
                      {tab.label}
                    </button>
                  ))}
                </div>

                <div className="space-y-4">
                  {GUIDE_MODULES_DATA.filter(g => guideFilter === 'ALL' || g.phase === guideFilter).map(item => (
                    <div key={item.phase} className="glass-card p-5 sm:p-6 rounded-2xl space-y-4">
                      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-white">
                        <div className="space-y-1">
                          <span className={`inline-block px-3 py-1 rounded-lg bg-gradient-to-r ${item.color} text-white text-[11px] font-bold shadow-2xs`}>{item.stepBadge}</span>
                          <h2 className="text-base sm:text-lg font-bold text-slate-900 pt-1">{lang === 'ko' ? item.titleKo : item.titleVi}</h2>
                          <p className="text-xs text-slate-600">{lang === 'ko' ? item.summaryKo : item.summaryVi}</p>
                        </div>
                        <button onClick={() => setActiveTab(item.actionTab)} className="self-start sm:self-center shrink-0 px-3.5 py-2 rounded-xl bg-white hover:bg-indigo-600 text-indigo-700 hover:text-white border border-white text-xs font-bold flex items-center gap-1.5 transition-colors">
                          <span>{lang === 'ko' ? item.actionLabelKo : item.actionLabelVi}</span>
                          <ArrowRight className="w-3.5 h-3.5" />
                        </button>
                      </div>
                      <div className="space-y-2.5">
                        {(lang === 'ko' ? item.stepsKo : item.stepsVi).map((stepText, idx) => (
                          <div key={idx} className="p-3.5 rounded-xl bg-white/80 border border-white flex items-start gap-3">
                            <span className="w-6 h-6 rounded-lg bg-indigo-600/15 text-indigo-700 font-bold text-xs flex items-center justify-center shrink-0 mt-0.5">{idx + 1}</span>
                            <div className="text-xs sm:text-[13px] text-slate-700 leading-relaxed">{stepText}</div>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              </section>
            )}

          </div>
        </div>
      </div>

      {/* ==================================================================== */}
      {/* MODALS                                                               */}
      {/* ==================================================================== */}

      {/* 1. Objective Modal */}
      {okrModal.open && okrModal.data && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/35 backdrop-blur-xs">
          <div className="bg-white/95 backdrop-blur-2xl rounded-3xl max-w-2xl w-full p-6 shadow-2xl border border-white max-h-[90vh] overflow-y-auto">
            <div className="flex items-center justify-between pb-3 border-b border-slate-200/60">
              <h3 className="font-bold text-lg text-slate-900">{okrModal.data.objectiveId ? 'Chỉnh sửa Mục Tiêu (Objective)' : 'Tạo Mục Tiêu (Objective)'}</h3>
              <button onClick={() => setOkrModal({ open: false, data: null })} className="p-2 rounded-xl text-slate-500 hover:bg-slate-100"><X className="w-5 h-5" /></button>
            </div>
            <form onSubmit={handleSaveOkrSubmit} className="space-y-3.5 mt-4">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Tiêu đề Tiếng Việt (titleVi) *</label>
                  <input required value={okrModal.data.titleVi} onChange={(e) => setOkrModal(p => ({ ...p, data: { ...p.data, titleVi: e.target.value } }))} className="w-full px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs sm:text-sm" />
                </div>
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Tiêu đề Tiếng Hàn (titleKo)</label>
                  <input value={okrModal.data.titleKo} onChange={(e) => setOkrModal(p => ({ ...p, data: { ...p.data, titleKo: e.target.value } }))} className="w-full px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs sm:text-sm" />
                </div>
              </div>
              <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Chu kỳ</label>
                  <select value={okrModal.data.cycleId} onChange={(e) => setOkrModal(p => ({ ...p, data: { ...p.data, cycleId: e.target.value } }))} className="w-full px-2.5 py-2 rounded-xl bg-white border border-slate-200 text-xs">
                    {db.cycles.map(c => <option key={c.cycleId} value={c.cycleId}>{getRawLocalized(c, 'name')}</option>)}
                  </select>
                </div>
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Cấp độ</label>
                  <select value={okrModal.data.level} onChange={(e) => setOkrModal(p => ({ ...p, data: { ...p.data, level: e.target.value } }))} className="w-full px-2.5 py-2 rounded-xl bg-white border border-slate-200 text-xs">
                    <option value="Company">Company</option>
                    <option value="Division">Division</option>
                    <option value="Department">Department</option>
                    <option value="Team">Team</option>
                    <option value="Individual">Individual</option>
                  </select>
                </div>
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Phòng ban</label>
                  <select value={okrModal.data.departmentId} onChange={(e) => setOkrModal(p => ({ ...p, data: { ...p.data, departmentId: e.target.value } }))} className="w-full px-2.5 py-2 rounded-xl bg-white border border-slate-200 text-xs">
                    {db.departments.map(d => <option key={d.departmentId} value={d.departmentId}>{getRawLocalized(d, 'name')}</option>)}
                  </select>
                </div>
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Objective Cha</label>
                  <select value={okrModal.data.parentObjectiveId} onChange={(e) => setOkrModal(p => ({ ...p, data: { ...p.data, parentObjectiveId: e.target.value } }))} className="w-full px-2.5 py-2 rounded-xl bg-white border border-slate-200 text-xs">
                    <option value="">-- Mục tiêu gốc --</option>
                    {db.objectives.filter(o => !o.deletedAt && o.objectiveId !== okrModal.data.objectiveId).map(o => (
                      <option key={o.objectiveId} value={o.objectiveId}>{getRawLocalized(o, 'title')}</option>
                    ))}
                  </select>
                </div>
              </div>
              {!okrModal.data.objectiveId && (
                <div className="p-3 rounded-2xl bg-indigo-50/80 border border-indigo-100 space-y-2">
                  <p className="text-xs font-bold text-indigo-800">Kết quả then chốt đầu tiên (Tùy chọn tạo kèm)</p>
                  <div className="grid grid-cols-1 sm:grid-cols-4 gap-2">
                    <input value={okrModal.data.initKrTitle} onChange={(e) => setOkrModal(p => ({ ...p, data: { ...p.data, initKrTitle: e.target.value } }))} placeholder="Tên KR tiêu biểu..." className="sm:col-span-2 px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                    <input type="number" value={okrModal.data.initKrTarget} onChange={(e) => setOkrModal(p => ({ ...p, data: { ...p.data, initKrTarget: e.target.value } }))} placeholder="Target (100)" className="px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                    <input value={okrModal.data.initKrUnit} onChange={(e) => setOkrModal(p => ({ ...p, data: { ...p.data, initKrUnit: e.target.value } }))} placeholder="Đơn vị (%)" className="px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                  </div>
                </div>
              )}
              <div className="flex justify-end gap-2 pt-3 border-t border-slate-200/60">
                <button type="button" onClick={() => setOkrModal({ open: false, data: null })} className="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100">Hủy bỏ</button>
                <button type="submit" className="px-5 py-2.5 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-md">Lưu vào Google Sheets</button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* 2. Key Result Modal */}
      {krModal.open && krModal.data && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/35 backdrop-blur-xs">
          <div className="bg-white/95 backdrop-blur-2xl rounded-3xl max-w-2xl w-full p-6 shadow-2xl border border-white max-h-[90vh] overflow-y-auto">
            <div className="flex items-center justify-between pb-3 border-b border-slate-200/60">
              <h3 className="font-bold text-lg text-slate-900">Thiết lập Kết quả then chốt (Key Result)</h3>
              <button onClick={() => setKrModal({ open: false, data: null })} className="p-2 rounded-xl text-slate-500 hover:bg-slate-100"><X className="w-5 h-5" /></button>
            </div>
            <form onSubmit={handleSaveKrSubmit} className="space-y-3.5 mt-4">
              <div>
                <label className="block text-xs font-bold text-slate-700 mb-1">Thuộc Mục tiêu (Objective) *</label>
                <select required value={krModal.data.objectiveId} onChange={(e) => setKrModal(p => ({ ...p, data: { ...p.data, objectiveId: e.target.value } }))} className="w-full px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs">
                  {db.objectives.filter(o => !o.deletedAt).map(o => <option key={o.objectiveId} value={o.objectiveId}>{getRawLocalized(o, 'title')}</option>)}
                </select>
              </div>
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Tên KR Tiếng Việt (titleVi) *</label>
                  <input required value={krModal.data.titleVi} onChange={(e) => setKrModal(p => ({ ...p, data: { ...p.data, titleVi: e.target.value } }))} className="w-full px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                </div>
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Tên KR Tiếng Hàn (titleKo)</label>
                  <input value={krModal.data.titleKo} onChange={(e) => setKrModal(p => ({ ...p, data: { ...p.data, titleKo: e.target.value } }))} className="w-full px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                </div>
              </div>
              <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Metric Type</label>
                  <select value={krModal.data.metricType} onChange={(e) => setKrModal(p => ({ ...p, data: { ...p.data, metricType: e.target.value } }))} className="w-full px-2.5 py-2 rounded-xl bg-white border border-slate-200 text-xs">
                    <option value="NUMBER">Number</option>
                    <option value="PERCENTAGE">Percentage</option>
                    <option value="CURRENCY">Currency</option>
                    <option value="BOOLEAN">Boolean</option>
                    <option value="MILESTONE">Milestone</option>
                    <option value="RANGE">Range</option>
                    <option value="MANUAL">Manual</option>
                  </select>
                </div>
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Direction</label>
