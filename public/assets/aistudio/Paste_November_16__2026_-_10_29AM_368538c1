                      </div>
                      <div>
                        <label className="block font-bold text-slate-700 mb-1">Tần suất Check-in</label>
                        <select value={db.settings.checkinFrequency} onChange={(e) => setDb(p => ({ ...p, settings: { ...p.settings, checkinFrequency: e.target.value } }))} className="w-full px-3 py-2 rounded-xl bg-white border border-slate-200">
                          <option value="WEEKLY">Hàng tuần (Weekly)</option>
                          <option value="BIWEEKLY">Hai tuần (Bi-weekly)</option>
                          <option value="MONTHLY">Hàng tháng (Monthly)</option>
                        </select>
                      </div>
                      <div>
                        <label className="block font-bold text-slate-700 mb-1">Ngưỡng ON_TRACK (%)</label>
                        <input type="number" value={db.settings.onTrackThreshold} onChange={(e) => setDb(p => ({ ...p, settings: { ...p.settings, onTrackThreshold: e.target.value } }))} className="w-full px-3 py-2 rounded-xl bg-white border border-slate-200" />
                      </div>
                      <div>
                        <label className="block font-bold text-slate-700 mb-1">Ngưỡng AT_RISK (%)</label>
                        <input type="number" value={db.settings.atRiskThreshold} onChange={(e) => setDb(p => ({ ...p, settings: { ...p.settings, atRiskThreshold: e.target.value } }))} className="w-full px-3 py-2 rounded-xl bg-white border border-slate-200" />
                      </div>
                    </div>
                    <button onClick={async () => { await callBackend('saveSettings', { data: db.settings }); showToast('Đã lưu cài đặt hệ thống!'); }} className="px-4 py-2 rounded-xl bg-indigo-600 text-white text-xs font-bold">
                      Lưu cấu hình SETTINGS
                    </button>
                  </div>
                </div>

                <div className="glass-card p-5 rounded-2xl overflow-x-auto">
                  <h2 className="font-bold text-base text-slate-900 mb-3">Nhật ký Hoạt động Hệ thống (AUDIT_LOGS)</h2>
                  <table className="w-full text-left text-xs">
                    <thead>
                      <tr className="border-b border-white bg-white/60">
                        <th className="p-2.5 font-bold">Thời gian</th>
                        <th className="p-2.5 font-bold">Người thực hiện</th>
                        <th className="p-2.5 font-bold">Hành động</th>
                        <th className="p-2.5 font-bold">Đối tượng</th>
                        <th className="p-2.5 font-bold">Chi tiết</th>
                      </tr>
                    </thead>
                    <tbody className="divide-y divide-white/70">
                      {db.auditLogs.slice(0, 25).map(l => (
                        <tr key={l.logId}>
                          <td className="p-2.5 text-slate-500">{formatLocaleDate(l.timestamp)}</td>
                          <td className="p-2.5 font-bold">{l.userId}</td>
                          <td className="p-2.5"><span className="px-2 py-0.5 rounded bg-slate-100 font-bold">{l.action}</span></td>
                          <td className="p-2.5">{l.entityType} ({l.entityId})</td>
                          <td className="p-2.5 text-slate-600">{l.newValue}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </section>
            )}

            {/* ============================================================== */}
            {/* VIEW 14: STEP-BY-STEP USER GUIDE                               */}
            {/* ============================================================== */}
            {activeTab === 'guide' && (
              <section className="flex-1 min-h-0 p-4 sm:p-6 space-y-5 overflow-y-auto">
                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div>
                    <h1 className="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2.5">
                      <span className="w-8 h-8 rounded-xl bg-gradient-to-tr from-blue-600 via-indigo-600 to-fuchsia-500 text-white flex items-center justify-center shadow-sm">
                        <BookOpenCheck className="w-4 h-4" />
                      </span>
                      <span>{t.guidePageTitle}</span>
                    </h1>
                    <p className="text-xs sm:text-sm text-slate-600 mt-1">{t.guidePageSub}</p>
                  </div>
                  <div className="flex items-center gap-2">
                    <button onClick={() => setActiveTab('settings')} className="px-3.5 py-2 rounded-xl bg-white text-indigo-700 border border-white text-xs font-bold flex items-center gap-1.5">
                      <Settings className="w-3.5 h-3.5" />
                      <span>{t.navSettings}</span>
                    </button>
                    <button onClick={() => window.print()} className="px-3.5 py-2 rounded-xl bg-indigo-600 text-white text-xs font-bold flex items-center gap-1.5">
