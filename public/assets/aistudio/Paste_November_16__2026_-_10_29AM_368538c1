                                      <button onClick={() => handleAdvanceTask(task)} className="p-1 rounded-lg bg-indigo-50 text-indigo-600 hover:bg-indigo-600 hover:text-white shrink-0">
                                        <ArrowRight className="w-3 h-3" />
                                      </button>
