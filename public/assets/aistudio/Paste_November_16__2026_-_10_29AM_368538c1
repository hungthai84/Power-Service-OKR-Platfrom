                      <option value="ALL">Tất cả Objectives</option>
                      {db.objectives.filter(o => !o.deletedAt).map(o => (
                        <option key={o.objectiveId} value={o.objectiveId}>{getRawLocalized(o, 'title')}</option>
                      ))}
                    </select>
                    <select value={krTypeFilter} onChange={(e) => setKrTypeFilter(e.target.value)} className="text-xs font-bold text-slate-700 bg-white border border-white rounded-xl px-3 py-2 outline-none">
