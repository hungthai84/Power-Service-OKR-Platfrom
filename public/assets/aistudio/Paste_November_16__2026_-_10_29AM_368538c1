                      <option value="NUMBER">Number</option>
                      <option value="PERCENTAGE">Percentage</option>
                      <option value="CURRENCY">Currency</option>
                      <option value="BOOLEAN">Boolean</option>
                      <option value="MILESTONE">Milestone</option>
                      <option value="RANGE">Range / Maintain</option>
                      <option value="MANUAL">Manual Score</option>
                    </select>
                  </div>
                </div>

                <div className="grid grid-cols-1 lg:grid-cols-2 gap-4">
                  {db.keyResults.filter(k => !k.deletedAt && (krObjFilter === 'ALL' || k.objectiveId === krObjFilter) && (krTypeFilter === 'ALL' || k.metricType === krTypeFilter)).map(kr => {
                    const parentObj = db.objectives.find(o => o.objectiveId === kr.objectiveId);
                    return (
                      <div key={kr.krId} className="glass-card p-5 rounded-2xl space-y-3">
                        <div className="flex items-start justify-between gap-2">
                          <div>
                            <div className="flex items-center gap-1.5 mb-1">
                              <span className="px-2 py-0.5 rounded bg-emerald-500/15 text-emerald-700 text-[10px] font-bold">{kr.metricType} • {kr.direction}</span>
                              {renderStatusPill(kr.status)}
                            </div>
                            <h3 className="text-sm font-bold text-slate-900">{renderLocalized(kr, 'title')}</h3>
                            <p className="text-[11px] text-slate-500 mt-0.5">Objective: {parentObj ? getRawLocalized(parentObj, 'title') : kr.objectiveId}</p>
                          </div>
                          <span className="text-lg font-bold text-emerald-700">{kr.progress || 0}%</span>
                        </div>
                        <div className="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                          <div className="h-full bg-gradient-to-r from-emerald-500 to-teal-500 rounded-full" style={{ width: `${kr.progress || 0}%` }} />
                        </div>
                        <div className="flex items-center justify-between text-xs pt-2 border-t border-white">
                          <span className="text-slate-600">
                            Baseline: <b>{formatLocaleNumber(kr.baselineValue, kr.metricType, kr.unit)}</b> → Current: <b>{formatLocaleNumber(kr.currentValue, kr.metricType, kr.unit)}</b> → Target: <b>{formatLocaleNumber(kr.targetValue, kr.metricType, kr.unit)}</b>
                          </span>
                          <div className="flex items-center gap-1.5">
                            <button onClick={() => openCheckInModal(kr)} className="px-3 py-1.5 rounded-xl bg-indigo-600 text-white font-bold">Check-in</button>
                            <button onClick={() => openKrModal(kr.objectiveId, kr)} className="px-2.5 py-1.5 rounded-xl bg-white text-slate-700 font-bold">Sửa</button>
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              </section>
            )}

            {/* ============================================================== */}
            {/* VIEW 04: CHECK-IN MANAGEMENT                                   */}
            {/* ============================================================== */}
            {activeTab === 'checkins' && (
              <section className="flex-1 min-h-0 p-4 sm:p-6 space-y-5 overflow-y-auto">
                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div>
                    <h1 className="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2.5">
                      <span className="w-8 h-8 rounded-xl bg-gradient-to-tr from-indigo-600 to-purple-600 text-white flex items-center justify-center shadow-sm">
                        <Activity className="w-4 h-4" />
                      </span>
                      <span>{t.checkinPageTitle}</span>
                    </h1>
                    <p className="text-xs sm:text-sm text-slate-600 mt-1">{t.checkinPageSub}</p>
                  </div>
                  <button onClick={() => { const first = db.keyResults.find(k => !k.deletedAt); if (first) openCheckInModal(first); else showToast('Chưa có KR để Check-in', 'error'); }} className="flex items-center gap-2 bg-gradient-to-r from-indigo-600 to-fuchsia-600 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-md">
                    <Layers className="w-4 h-4" />
                    <span>{t.bulkCheckinBtn}</span>
                  </button>
                </div>

                <div className="grid grid-cols-1 lg:grid-cols-12 gap-5">
                  <div className="lg:col-span-5 glass-card p-5 rounded-2xl">
                    <h2 className="font-bold text-base text-slate-900 mb-3">Danh sách KR cần Check-in</h2>
                    <div className="space-y-2.5 max-h-[450px] overflow-y-auto">
                      {db.keyResults.filter(k => !k.deletedAt).map(kr => (
                        <div key={kr.krId} className="p-3 rounded-xl bg-white/80 border border-white flex items-center justify-between gap-2">
                          <div className="min-w-0">
                            <p className="text-xs font-bold text-slate-800 truncate">{renderLocalized(kr, 'title')}</p>
                            <p className="text-[11px] text-slate-500">Tiến độ: {kr.progress || 0}% • Lần cuối: {kr.lastCheckinAt ? formatLocaleDate(kr.lastCheckinAt) : 'Chưa check-in'}</p>
                          </div>
                          <button onClick={() => openCheckInModal(kr)} className="px-3 py-1.5 rounded-xl bg-indigo-600 text-white text-xs font-bold shrink-0">Check-in</button>
                        </div>
                      ))}
                    </div>
                  </div>

                  <div className="lg:col-span-7 glass-card p-5 rounded-2xl">
                    <h2 className="font-bold text-base text-slate-900 mb-3">Nhật ký Check-in gần nhất (CHECKINS)</h2>
                    <div className="space-y-3 max-h-[450px] overflow-y-auto">
                      {db.checkins.length === 0 ? (
                        <p className="text-xs text-slate-500 text-center py-8">Chưa có bản ghi lịch sử Check-in nào.</p>
                      ) : db.checkins.map(ci => {
                        const kr = db.keyResults.find(k => k.krId === ci.krId);
                        return (
                          <div key={ci.checkInId} className="p-3.5 rounded-xl bg-white/85 border border-white space-y-1.5">
                            <div className="flex items-center justify-between gap-2">
                              <span className="text-xs font-bold text-indigo-700">{kr ? getRawLocalized(kr, 'title') : ci.krId}</span>
                              <span className="px-2 py-0.5 rounded-full bg-indigo-100 text-indigo-800 text-[11px] font-bold">{ci.calculatedProgress}% (Conf: {ci.confidenceScore}/10)</span>
                            </div>
                            <p className="text-xs text-slate-800"><b>Wins:</b> {renderLocalized(ci, 'wins')}</p>
                            {ci.blockersVi && <p className="text-xs text-rose-700"><b>Blockers:</b> {ci.blockersVi}</p>}
                            {ci.nextStepsVi && <p className="text-xs text-emerald-700"><b>Next:</b> {ci.nextStepsVi}</p>}
                            <div className="flex items-center justify-between text-[11px] text-slate-500 pt-1">
                              <span>{ci.ownerId}</span>
                              <span>{formatLocaleDate(ci.createdAt)}</span>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                </div>
              </section>
            )}

            {/* ============================================================== */}
            {/* VIEW 05: KANBAN 6 COLUMNS                                      */}
            {/* ============================================================== */}
            {activeTab === 'kanban' && (
              <section className="flex-1 min-h-0 p-4 sm:p-6 space-y-5 overflow-y-auto">
                <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div>
                    <h1 className="text-xl sm:text-2xl font-bold text-slate-900 flex items-center gap-2.5">
                      <span className="w-8 h-8 rounded-xl bg-gradient-to-tr from-indigo-500 to-fuchsia-500 text-white flex items-center justify-center shadow-sm">
