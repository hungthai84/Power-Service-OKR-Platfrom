                    <option value="INCREASE">Increase</option>
                    <option value="DECREASE">Decrease</option>
                    <option value="MAINTAIN">Maintain</option>
                  </select>
                </div>
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Đơn vị</label>
                  <input value={krModal.data.unit} onChange={(e) => setKrModal(p => ({ ...p, data: { ...p.data, unit: e.target.value } }))} className="w-full px-2.5 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                </div>
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Trọng số</label>
                  <input type="number" step="0.1" value={krModal.data.weight} onChange={(e) => setKrModal(p => ({ ...p, data: { ...p.data, weight: e.target.value } }))} className="w-full px-2.5 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                </div>
              </div>
              <div className="grid grid-cols-3 gap-3">
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Baseline</label>
                  <input type="number" step="any" value={krModal.data.baselineValue} onChange={(e) => setKrModal(p => ({ ...p, data: { ...p.data, baselineValue: e.target.value } }))} className="w-full px-2.5 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                </div>
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Current Value</label>
                  <input type="number" step="any" value={krModal.data.currentValue} onChange={(e) => setKrModal(p => ({ ...p, data: { ...p.data, currentValue: e.target.value } }))} className="w-full px-2.5 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                </div>
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Target Value *</label>
                  <input type="number" step="any" required value={krModal.data.targetValue} onChange={(e) => setKrModal(p => ({ ...p, data: { ...p.data, targetValue: e.target.value } }))} className="w-full px-2.5 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                </div>
              </div>
              <div className="flex justify-end gap-2 pt-3 border-t border-slate-200/60">
                <button type="button" onClick={() => setKrModal({ open: false, data: null })} className="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100">Hủy</button>
                <button type="submit" className="px-5 py-2 rounded-xl text-xs font-bold bg-emerald-600 text-white">Lưu Key Result</button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* 3. Check-in Modal */}
      {checkinModal.open && checkinModal.kr && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/35 backdrop-blur-xs">
          <div className="bg-white/95 backdrop-blur-2xl rounded-3xl max-w-xl w-full p-6 shadow-2xl border border-white max-h-[90vh] overflow-y-auto">
            <div className="flex items-center justify-between pb-3 border-b border-slate-200/60">
              <div>
                <h3 className="font-bold text-lg text-slate-900">Check-in Tiến độ Key Result</h3>
                <p className="text-xs text-indigo-600 font-bold mt-0.5">{getRawLocalized(checkinModal.kr, 'title')}</p>
              </div>
              <button onClick={() => setCheckinModal(p => ({ ...p, open: false }))} className="p-2 rounded-xl text-slate-500 hover:bg-slate-100"><X className="w-5 h-5" /></button>
            </div>
            <form onSubmit={handleCheckInSubmit} className="space-y-3.5 mt-4">
              <div className="grid grid-cols-3 gap-3 p-3 rounded-2xl bg-indigo-50/80 border border-indigo-100">
                <div>
                  <label className="block text-[11px] font-bold text-slate-600">Baseline → Target</label>
                  <p className="text-xs font-bold text-slate-900 mt-1">{checkinModal.kr.baselineValue} → {checkinModal.kr.targetValue} {checkinModal.kr.unit}</p>
                </div>
                <div>
                  <label className="block text-[11px] font-bold text-slate-700">Giá trị hiện tại *</label>
                  <input type="number" step="any" required value={checkinModal.currentValue} onChange={(e) => setCheckinModal(p => ({ ...p, currentValue: e.target.value }))} className="w-full px-2.5 py-1.5 rounded-xl bg-white border border-indigo-200 text-xs font-bold mt-0.5" />
                </div>
                <div>
                  <label className="block text-[11px] font-bold text-slate-600">Tiến độ tính toán</label>
                  <p className="text-base font-bold text-indigo-700 mt-0.5">
                    {calculateKrProgress({ ...checkinModal.kr, currentValue: Number(checkinModal.currentValue) })}%
                  </p>
                </div>
              </div>
              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Mức độ tự tin (1-10)</label>
                  <input type="number" min="1" max="10" value={checkinModal.confidence} onChange={(e) => setCheckinModal(p => ({ ...p, confidence: e.target.value }))} className="w-full px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                </div>
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Trạng thái đánh giá</label>
                  <select value={checkinModal.status} onChange={(e) => setCheckinModal(p => ({ ...p, status: e.target.value }))} className="w-full px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs">
                    <option value="ON_TRACK">ON TRACK</option>
                    <option value="AT_RISK">AT RISK</option>
                    <option value="BEHIND">BEHIND</option>
                    <option value="COMPLETED">COMPLETED</option>
                  </select>
                </div>
              </div>
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Kết quả đạt được (Wins - VI) *</label>
                  <textarea rows="2" required value={checkinModal.winsVi} onChange={(e) => setCheckinModal(p => ({ ...p, winsVi: e.target.value }))} className="w-full px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                </div>
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">성과 요약 (Wins - KO)</label>
                  <textarea rows="2" value={checkinModal.winsKo} onChange={(e) => setCheckinModal(p => ({ ...p, winsKo: e.target.value }))} className="w-full px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                </div>
              </div>
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Khó khăn / Rào cản (Blockers)</label>
                  <textarea rows="2" value={checkinModal.blockersVi} onChange={(e) => setCheckinModal(p => ({ ...p, blockersVi: e.target.value }))} className="w-full px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                </div>
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Kế hoạch tiếp theo (Next Steps)</label>
                  <textarea rows="2" value={checkinModal.nextStepsVi} onChange={(e) => setCheckinModal(p => ({ ...p, nextStepsVi: e.target.value }))} className="w-full px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                </div>
              </div>
              <div className="flex justify-end gap-2 pt-3 border-t border-slate-200/60">
                <button type="button" onClick={() => setCheckinModal(p => ({ ...p, open: false }))} className="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100">Hủy</button>
                <button type="submit" className="px-5 py-2 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-md">Ghi nhận Check-in</button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* 4. Add Initiative Modal */}
      {taskModal.open && taskModal.data && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/35 backdrop-blur-xs">
          <div className="bg-white/95 backdrop-blur-2xl rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-white">
            <div className="flex items-center justify-between pb-3 border-b border-slate-200/60">
              <h3 className="font-bold text-lg text-slate-900">Quản lý Sáng kiến (Initiative)</h3>
              <button onClick={() => setTaskModal({ open: false, data: null })} className="p-2 rounded-xl text-slate-500 hover:bg-slate-100"><X className="w-5 h-5" /></button>
            </div>
            <form onSubmit={handleSaveTaskSubmit} className="space-y-3.5 mt-4">
              <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Tên sáng kiến (VI) *</label>
                  <input required value={taskModal.data.titleVi} onChange={(e) => setTaskModal(p => ({ ...p, data: { ...p.data, titleVi: e.target.value } }))} className="w-full px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                </div>
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Tên sáng kiến (KO)</label>
                  <input value={taskModal.data.titleKo} onChange={(e) => setTaskModal(p => ({ ...p, data: { ...p.data, titleKo: e.target.value } }))} className="w-full px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                </div>
              </div>
              <div className="grid grid-cols-3 gap-3">
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Ưu tiên</label>
                  <select value={taskModal.data.priority} onChange={(e) => setTaskModal(p => ({ ...p, data: { ...p.data, priority: e.target.value } }))} className="w-full px-2.5 py-2 rounded-xl bg-white border border-slate-200 text-xs">
                    <option value="HIGH">High</option>
                    <option value="MEDIUM">Medium</option>
                    <option value="LOW">Low</option>
                  </select>
                </div>
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Trạng thái</label>
                  <select value={taskModal.data.status} onChange={(e) => setTaskModal(p => ({ ...p, data: { ...p.data, status: e.target.value } }))} className="w-full px-2.5 py-2 rounded-xl bg-white border border-slate-200 text-xs">
                    <option value="BACKLOG">BACKLOG</option>
                    <option value="TO_DO">TO DO</option>
                    <option value="IN_PROGRESS">IN PROGRESS</option>
                    <option value="BLOCKED">BLOCKED</option>
                    <option value="REVIEW">REVIEW</option>
                    <option value="DONE">DONE</option>
                  </select>
                </div>
                <div>
                  <label className="block text-xs font-bold text-slate-700 mb-1">Deadline</label>
                  <input type="date" value={taskModal.data.dueDate} onChange={(e) => setTaskModal(p => ({ ...p, data: { ...p.data, dueDate: e.target.value } }))} className="w-full px-2.5 py-2 rounded-xl bg-white border border-slate-200 text-xs" />
                </div>
              </div>
              <div className="flex justify-end gap-2 pt-3 border-t border-slate-200/60">
                <button type="button" onClick={() => setTaskModal({ open: false, data: null })} className="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100">Hủy</button>
                <button type="submit" className="px-5 py-2 rounded-xl text-xs font-bold bg-indigo-600 text-white">Lưu Initiative</button>
              </div>
            </form>
          </div>
        </div>
      )}

      {/* 5. Objective Detail & Comments Modal */}
      {detailObj && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/35 backdrop-blur-xs">
          <div className="bg-white/95 backdrop-blur-2xl rounded-3xl max-w-3xl w-full p-6 shadow-2xl border border-white max-h-[90vh] overflow-y-auto space-y-4">
            <div className="flex items-center justify-between pb-3 border-b border-slate-200/60">
              <h3 className="font-bold text-lg text-slate-900">{renderLocalized(detailObj, 'title')}</h3>
              <button onClick={() => setDetailModalObjId(null)} className="p-2 rounded-xl text-slate-500 hover:bg-slate-100"><X className="w-5 h-5" /></button>
            </div>

            <div className="p-4 rounded-2xl bg-indigo-50/70 border border-indigo-100 space-y-2">
              <div className="flex items-center justify-between">
                <div className="flex items-center gap-2">
                  <span className="px-2.5 py-0.5 rounded-lg bg-indigo-600 text-white text-xs font-bold">{detailObj.level}</span>
                  {renderStatusPill(detailObj.status)}
                </div>
                <span className="text-lg font-bold text-indigo-700">{detailObj.progress || 0}%</span>
              </div>
              <p className="text-xs text-slate-600">{renderLocalized(detailObj, 'description') || 'Chưa có mô tả chi tiết.'}</p>
            </div>

            <div className="space-y-2">
              <div className="flex items-center justify-between">
                <h4 className="text-xs font-bold uppercase text-slate-600">Danh sách Key Results</h4>
                <button onClick={() => { setDetailModalObjId(null); openKrModal(detailObj.objectiveId); }} className="text-xs font-bold text-indigo-600 hover:underline">+ Thêm Key Result</button>
              </div>
              {db.keyResults.filter(k => k.objectiveId === detailObj.objectiveId && !k.deletedAt).map(kr => (
                <div key={kr.krId} className="p-3 rounded-xl bg-white border border-slate-200/80 flex items-center justify-between gap-2">
                  <div>
                    <p className="text-xs font-bold text-slate-900">{renderLocalized(kr, 'title')}</p>
                    <p className="text-[11px] text-slate-500">{formatLocaleNumber(kr.currentValue, kr.metricType, kr.unit)} / {formatLocaleNumber(kr.targetValue, kr.metricType, kr.unit)} ({kr.progress || 0}%)</p>
                  </div>
                  <button onClick={() => { setDetailModalObjId(null); openCheckInModal(kr); }} className="px-3 py-1.5 rounded-xl bg-indigo-600 text-white text-xs font-bold">Check-in</button>
                </div>
              ))}
            </div>

            <div className="space-y-2 pt-2 border-t border-slate-200/60">
              <h4 className="text-xs font-bold uppercase text-slate-600">Thảo luận & Bình luận</h4>
              <form onSubmit={async (e) => { e.preventDefault(); if (!detailCommentInput.trim()) return; await callBackend('addComment', { entityType: 'OBJECTIVE', entityId: detailObj.objectiveId, bodyVi: detailCommentInput.trim() }); setDetailCommentInput(''); showToast('Đã gửi bình luận!'); }} className="flex gap-2">
                <input value={detailCommentInput} onChange={(e) => setDetailCommentInput(e.target.value)} required placeholder="Nhập nội dung trao đổi..." className="flex-1 px-3 py-2 rounded-xl bg-white border border-slate-200 text-xs outline-none" />
                <button type="submit" className="px-4 py-2 rounded-xl bg-indigo-600 text-white text-xs font-bold">Gửi</button>
              </form>
              <div className="space-y-1.5 max-h-40 overflow-y-auto">
                {db.comments.filter(c => c.entityId === detailObj.objectiveId).map(c => (
                  <div key={c.commentId} className="p-2.5 rounded-xl bg-slate-50 border border-slate-200/60 text-xs">
                    <p className="text-slate-800">{c.bodyVi}</p>
                    <span className="text-[10px] text-slate-400">{c.userId} • {formatLocaleDate(c.createdAt)}</span>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      )}

      {/* 6. Custom Confirmation Modal */}
      {confirmDialog.open && (
        <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/35 backdrop-blur-xs">
          <div className="bg-white/95 backdrop-blur-2xl rounded-3xl max-w-md w-full p-6 shadow-2xl border border-white">
            <h3 className="font-bold text-base text-slate-900">{confirmDialog.title}</h3>
            <p className="text-xs text-slate-600 mt-2 leading-relaxed">{confirmDialog.message}</p>
            <div className="flex justify-end gap-2 mt-5">
              <button onClick={() => setConfirmDialog({ open: false, title: '', message: '', onConfirm: null })} className="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100">Hủy bỏ</button>
              <button onClick={confirmDialog.onConfirm} className="px-4 py-2 rounded-xl text-xs font-bold bg-rose-600 text-white hover:bg-rose-700">Xác nhận</button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}